// ================================================================
// SISTEMA / AUTH
// ================================================================

// Tenant = Organización (documento maestro v2.0, D1/D2). Se extiende la tabla
// existente en lugar de crear otra: conserva los ids y todas las FK "tenantId".
model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  farmName    String // = nombre de la organización
  plan        Plan     @default(FREE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  config      Json     @default("{}")
  phoneNumber String? // Número principal (para identificar la organización en WhatsApp)
  isActive    Boolean  @default(true) // legado; la fuente de verdad pasa a ser `estado`

  tipo               TipoOrganizacion   @default(EMPRESA)
  codigoUnion        String             @unique @default(dbgenerated("upper(substr(md5((random())::text), 1, 8))")) // "Unirme a una empresa" y login de cuentas gestionadas
  razonSocial        String?
  ruc                String?
  rubro              String?
  pais               String             @default("PY")
  departamento       String?
  distrito           String?
  whatsapp           String?
  logoUrl            String?
  estado             EstadoOrganizacion @default(ACTIVA)
  verificacion       EstadoVerificacion @default(NO_APLICA)
  compartirBenchmark Boolean            @default(false) // aparecer anonimizada en comparativas que ven otros usuarios
  creadoPor          String? // users.id del creador

  users        User[]
  granjas      Granja[]
  unidades     UnidadNegocio[]
  miembros     Miembro[]
  roles        Rol[]
  invitaciones Invitacion[]

  // Finanzas (Fase 8)
  cuentasFondos         CuentaFondos[]
  categoriasFinancieras CategoriaFinanciera[]
  contrapartes          Contraparte[]
  movimientos           Movimiento[]
  ventas                Venta[]
  prestamos             Prestamo[]
  presupuestos          Presupuesto[]
  aportesPrevistos      AporteCapitalPrevisto[]
  evaluacionesInversion EvaluacionInversion[]
  parametrosFinancieros ParametrosFinancieros?
  cierresMes            CierreMes[]
  saldosDeclarados      SaldoDeclarado[]
  causasDesvio          CausaDesvio[]
  recomendaciones       Recomendacion[]

  @@index([tipo])
  @@index([departamento])
  @@map("tenants")
}

// Roles fijos del sistema — se inicializan en seed
// ID 1–14 mapeados 1:1 con la especificación del documento
model Role {
  id          Int    @id
  name        String @unique // slug en inglés: "farm_admin"
  nameEs      String // Nombre en español: "Admin de granja"
  level       Int
  description String

  userRoles UserRole[]

  @@map("roles")
}

// User = Perfil (la persona, D1). Se extiende la tabla existente.
// `tenantId` y `passwordHash` son legado de NextAuth (opcionales desde la Fase 3):
// la identidad vive en Supabase Auth y la pertenencia a organizaciones en `Miembro`.
model User {
  id           String   @id @default(cuid())
  tenantId     String? // legado: organización "principal"; la pertenencia real está en Miembro
  email        String   @unique
  passwordHash String? // legado NextAuth; la contraseña vive en Supabase Auth
  name         String
  phone        String? // Número WhatsApp del usuario/operario (+595)
  language     Language @default(ES)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authUserId         String?      @unique @db.Uuid // = auth.users.id (Supabase Auth, Fase 3)
  avatarUrl          String?
  departamento       String?
  distrito           String?
  tipoRegistro       TipoRegistro @default(COMPRADOR)
  proveedorLogin     String       @default("email") // google | email | gestionada
  tipoAcceso         TipoAcceso   @default(NORMAL)
  debeCambiarClave   Boolean      @default(false)
  declaraMayorEdad   Boolean      @default(false)
  onboardingCompleto Boolean      @default(false)
  ultimoAcceso       DateTime?
  bajaSolicitadaEn   DateTime?

  tenant              Tenant?                 @relation(fields: [tenantId], references: [id])
  userRoles           UserRole[]
  pushTokens          PushToken[]
  notificationPref    NotificationPreference?
  assignedHealthTasks HealthTask[]            @relation("AssignedHealthTasks")
  membresias          Miembro[]
  adminPlataforma     AdminPlataforma?

  @@index([tenantId])
  @@map("users")
}

model UserRole {
  userId    String
  roleId    Int
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// ================================================================
// INSTALACIONES: SECTORES Y CORRALES
// ================================================================

model FarmLocation {
  id           String       @id @default(cuid())
  tenantId     String
  granjaId     String? // granja a la que pertenece el sector (Fase 1)
  name         String // "Calle 6", "Galpón A", "Sala Maternidad 1"
  locationType LocationType
  isActive     Boolean      @default(true)

  granja Granja? @relation(fields: [granjaId], references: [id])
  pens   Pen[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([granjaId])
  @@map("farm_locations")
}

model Pen {
  id         String  @id @default(cuid())
  tenantId   String
  locationId String
  number     String // "8", "A3" — único dentro de la ubicación
  capacity   Int
  isActive   Boolean @default(true)

  location       FarmLocation     @relation(fields: [locationId], references: [id])
  nurseryBatches NurseryBatch[]
  growingBatches GrowingBatch[]
  farrowings     FarrowingEvent[]

  @@unique([tenantId, locationId, number])
  @@index([tenantId])
  @@map("pens")
}

// ================================================================
// REPRODUCTORES
// ================================================================

model Sow {
  id                 String           @id @default(cuid())
  tenantId           String
  identCode          String // Tatuaje o número único (campo original)
  breed              String?
  birthDate          DateTime?
  entryDate          DateTime         @default(now())
  currentParityCount Int              @default(0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  // Plantel Reproductivo — nullable para compat. con registros existentes
  erpCode            String? // HEM-GRN-NNNN generado automáticamente
  caravanaCode       String?
  tattooCode         String?
  rfidChip           String?
  photoUrl           String?
  geneticLine        String?
  entryWeightKg      Decimal?         @db.Decimal(8, 2)
  currentWeightKg    Decimal?         @db.Decimal(8, 2) // último peso registrado (ej. al inseminar) — entryWeightKg no se actualiza
  sourceProvider     String?
  purchasePriceGs    Decimal?         @db.Decimal(14, 0)
  damCodeOrigin      String?
  sireCodeOrigin     String?
  galponAssigned     String?
  corralAssigned     String?
  plantelState       SowPlantelState?
  plantelNotes       String?

  serviceEvents      ServiceEvent[]
  pregnancyChecks    PregnancyCheck[]
  heatRepeats        HeatRepeat[]
  abortions          AbortionEvent[]
  discards           SowDiscard[]
  farrowings         FarrowingEvent[]
  stockAdjustments   StockAdjustmentRequest[]
  animalEvents       AnimalEvent[]
  curativeTreatments CurativeTreatment[]
  withdrawalPeriods  WithdrawalPeriod[]
  necropsias         Necropsia[]

  @@unique([tenantId, identCode])
  @@unique([tenantId, erpCode])
  @@index([tenantId])
  @@map("sows")
}

model Boar {
  id              String            @id @default(cuid())
  tenantId        String
  identCode       String // Código original "R-204"
  breed           String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  // Plantel Reproductivo — nullable para compat. con registros existentes
  erpCode         String? // REP-GRN-NNNN generado automáticamente
  caravanaCode    String?
  tattooCode      String?
  rfidChip        String?
  photoUrl        String?
  geneticLine     String?
  birthDate       DateTime?
  entryDate       DateTime?
  entryWeightKg   Decimal?          @db.Decimal(8, 2)
  sourceProvider  String?
  purchasePriceGs Decimal?          @db.Decimal(14, 0)
  galponAssigned  String?
  corralAssigned  String?
  plantelState    BoarPlantelState?
  plantelNotes    String?

  semenDoses    SemenDose[]
  serviceEvents ServiceEvent[]
  animalEvents  AnimalEvent[]
  necropsias    Necropsia[]

  @@unique([tenantId, identCode])
  @@unique([tenantId, erpCode])
  @@index([tenantId])
  @@map("boars")
}

model SemenDose {
  id              String   @id @default(cuid())
  tenantId        String
  boarId          String?
  doseCode        String
  elaborationDate DateTime
  expiryDate      DateTime
  isUsed          Boolean  @default(false)
  createdAt       DateTime @default(now())

  boar          Boar?          @relation(fields: [boarId], references: [id])
  serviceEvents ServiceEvent[]

  @@index([tenantId])
  @@map("semen_doses")
}

// ================================================================
// MÓDULO CONFIG — configuración por módulo y tenant
// ================================================================

// KPIs / metas configurables por módulo
model ConfigMeta {
  id        String   @id @default(cuid())
  tenantId  String
  modulo    String // MATERNIDAD | GESTACION | RECRIA | ENGORDE | BAL
  kpiKey    String // nacidos_vivos_meta | mortalidad_pct | etc.
  valor     Decimal  @db.Decimal(10, 3)
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([tenantId, modulo, kpiKey])
  @@index([tenantId])
  @@map("config_metas")
}

// Catálogo de genética por tenant — separa "qué es" (tipoGenetico) de
// "para qué se usa" (funcion), para poder filtrar selects dependientes
// (alta de hembra → solo MATERNA, alta de reproductor → solo PATERNA).
model Genetica {
  id                String          @id @default(cuid())
  tenantId          String
  nombre            String
  empresa           String? // Topigs Norsvin, Nucleus, DanBred…
  tipoGenetico      TipoGenetico
  funcion           FuncionGenetica
  composicionRacial String? // "Landrace × Large White"
  metaNacidosVivos  Decimal?        @db.Decimal(6, 2) // solo aplica si funcion = MATERNA
  activa            Boolean         @default(true)
  notas             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([tenantId, nombre])
  @@index([tenantId])
  @@map("config_genetica")
}

enum TipoGenetico {
  RAZA_PURA
  HIBRIDA_F1
  SINTETICA
  CRUZA_INTERNA
}

enum FuncionGenetica {
  MATERNA
  PATERNA
}

// Protocolo de vacunas configurable (17 campos completos según v3)
model ConfigVacuna {
  id                   String            @id @default(cuid())
  tenantId             String
  modulo               String // MATERNIDAD | GESTACION | RECRIA | ENGORDE | ALL
  nombreVacuna         String
  marcaComercial       String
  laboratorio          String
  principioActivo      String
  enfermedadObjetivo   String? // Contra qué enfermedad actúa
  viaAplicacion        String // IM | SC | IV | ORAL | INTRANASAL
  dosisMl              Decimal           @db.Decimal(8, 3)
  momentoAplicacion    String
  refuerzoDias         Int?
  paisProcedencia      String
  tempConservacion     String
  diasAlertaVto        Int               @default(30)
  loteActual           String?
  fechaVencimientoLote DateTime?
  stockDosis           Int?
  stockMinimoAlerta    Int?
  fichaTecnicaUrl      String? // URL a la ficha técnica del producto
  obligatoria          Boolean           @default(false)
  diasEsperaServicio   Int               @default(0) // días post-vacuna obligatoria para autorizar servicio
  notas                String?
  activa               Boolean           @default(true)
  paridad              Paridad           @default(AMBAS) // a qué cerdas aplica este esquema de dosis
  diaGestacion         Int? // día exacto de gestación de esta dosis (alimenta alertas por fecha de servicio)
  ordenDosis           Int               @default(1) // número de dosis dentro del esquema de esta marca
  grupoMezclaId        String? // agrupa productos que se aplican mezclados el mismo día
  sujeto               SujetoAplicacion? // a quién se aplica (Maternidad: lechón o hembra en lactación)
  diaReferencia        Int? // día de vida (lechón) o día post-parto (hembra) — no confundir con diaGestacion
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([tenantId, modulo])
  @@map("config_vacunas")
}

enum Paridad {
  NULIPARA
  MULTIPARA
  AMBAS
}

enum SujetoAplicacion {
  LECHON
  HEMBRA
}

// Configuración de procesos operativos por módulo (valor flexible JSON)
model ConfigProceso {
  id         String   @id @default(cuid())
  tenantId   String
  modulo     String
  procesoKey String
  valor      Json
  updatedBy  String?
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, modulo, procesoKey])
  @@index([tenantId])
  @@map("config_procesos")
}

// Umbrales de alertas por módulo
model ConfigAlerta {
  id        String   @id @default(cuid())
  tenantId  String
  modulo    String
  eventoKey String
  umbral    Decimal? @db.Decimal(10, 3)
  canales   String[] // PUSH | WHATSAPP | EMAIL
  activa    Boolean  @default(true)
  gravedad  String   @default("WARNING") // INFO | WARNING | CRITICAL
  updatedAt DateTime @updatedAt

  @@unique([tenantId, modulo, eventoKey])
  @@index([tenantId])
  @@map("config_alertas")
}

// ================================================================
// MÓDULO 0: PLANTEL REPRODUCTIVO — modelos adicionales
// ================================================================

// Historial de eventos por animal (escritura desde cualquier módulo)
model AnimalEvent {
  id            String   @id @default(cuid())
  tenantId      String
  sowId         String?
  boarId        String?
  eventType     String // ENTRY | STATE_CHANGE | DEATH | DISCARD | SERVICE | FARROWING | WEANING | etc.
  eventDate     DateTime
  description   String?
  previousState String?
  newState      String?
  moduleSource  String? // PLANTEL | GESTACION | MATERNIDAD | SANIDAD
  userId        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  sow  Sow?  @relation(fields: [sowId], references: [id])
  boar Boar? @relation(fields: [boarId], references: [id])

  @@index([tenantId, sowId])
  @@index([tenantId, boarId])
  @@map("animal_events")
}

// Lotes de semen externo (identidad genética + stock físico)
model ExternalSemenLot {
  id             String   @id @default(cuid())
  tenantId       String
  lotCode        String // IN-GRN-NNNN generado automáticamente
  geneticLine    String
  donorBoarCode  String // Código del verraco en establecimiento de origen
  originFarm     String // Granja/Laboratorio de origen
  productionDate DateTime
  expiryDate     DateTime
  totalDoses     Int
  availableDoses Int
  pricePerDoseGs Decimal  @db.Decimal(14, 0)
  certUrl        String?
  observations   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, lotCode])
  @@index([tenantId])
  @@map("external_semen_lots")
}

// ================================================================
// MÓDULO 1A: GESTACIÓN
// ================================================================

// Agrupa cerdas servidas en la misma semana ISO
model ServiceBatch {
  id        String   @id @default(cuid())
  tenantId  String
  weekLabel String // Formato "2026-W25"
  code      String? // Código/nombre de lote explícito (null = agrupado automático por semana)
  notes     String?
  createdAt DateTime @default(now())

  serviceEvents ServiceEvent[]

  @@index([tenantId, weekLabel])
  @@index([tenantId])
  @@map("service_batches")
}

model ServiceEvent {
  id              String      @id @default(cuid())
  tenantId        String
  sowId           String
  boarId          String?
  semenDoseId     String?
  serviceBatchId  String
  serviceDate     DateTime
  serviceType     ServiceType
  durationMinutes Int?
  employeeId      String?
  notes           String?
  createdAt       DateTime    @default(now())

  sow             Sow              @relation(fields: [sowId], references: [id])
  boar            Boar?            @relation(fields: [boarId], references: [id])
  semenDose       SemenDose?       @relation(fields: [semenDoseId], references: [id])
  serviceBatch    ServiceBatch     @relation(fields: [serviceBatchId], references: [id])
  pregnancyChecks PregnancyCheck[]
  farrowing       FarrowingEvent?

  @@index([tenantId, sowId])
  @@index([tenantId, serviceDate])
  @@map("service_events")
}

model PregnancyCheck {
  id             String               @id @default(cuid())
  tenantId       String
  sowId          String
  serviceEventId String
  checkDate      DateTime
  method         PregnancyCheckMethod
  result         PregnancyCheckResult
  employeeId     String?
  notes          String?
  createdAt      DateTime             @default(now())

  sow          Sow          @relation(fields: [sowId], references: [id])
  serviceEvent ServiceEvent @relation(fields: [serviceEventId], references: [id])

  @@index([tenantId])
  @@map("pregnancy_checks")
}

model HeatRepeat {
  id             String   @id @default(cuid())
  tenantId       String
  sowId          String
  serviceEventId String?
  repeatDate     DateTime
  cause          String?
  employeeId     String?
  createdAt      DateTime @default(now())

  sow Sow @relation(fields: [sowId], references: [id])

  @@index([tenantId])
  @@map("heat_repeats")
}

model AbortionEvent {
  id             String   @id @default(cuid())
  tenantId       String
  sowId          String
  serviceEventId String?
  abortionDate   DateTime
  cause          String?
  vetDiagnosis   String?
  employeeId     String?
  createdAt      DateTime @default(now())

  sow Sow @relation(fields: [sowId], references: [id])

  @@index([tenantId])
  @@map("abortion_events")
}

model SowDiscard {
  id          String   @id @default(cuid())
  tenantId    String
  sowId       String
  discardDate DateTime
  reason      String   @default("")
  destination String?
  employeeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Categorización extendida
  categoria          String?
  motivosEspecificos String[]
  motivoPrincipal    String?
  tipoDescarte       String?

  // Estado al momento del descarte
  pesoKg             Decimal? @db.Decimal(8, 2)
  condicionCorporal  Int?
  estadoSanitario    String?
  estadoReproductivo String?
  estadoProductivo   String?

  // Info reproductiva
  numeroParto        Int?
  diasUltimoParto    Int?
  diasUltimoServicio Int?
  numeroServicios    Int?
  lechonesDestetados Int?

  // Info sanitaria
  diagnostico           String?
  veterinario           String?
  observacionesClinicas String? @db.Text

  // General
  observaciones       String? @db.Text
  responsableAutoriza String?

  sow Sow @relation(fields: [sowId], references: [id])

  @@index([tenantId])
  @@map("sow_discards")
}

// ================================================================
// MÓDULO 1B: MATERNIDAD
// ================================================================

model FarrowingEvent {
  id                  String        @id @default(cuid())
  tenantId            String
  sowId               String
  serviceEventId      String?       @unique
  farrowingType       FarrowingType @default(NORMAL)
  startDatetime       DateTime
  endDatetime         DateTime?
  // Campos calculados automáticamente al guardar
  gestationDays       Int? // fecha_parto - fecha_servicio
  durationMinutes     Int? // end - start
  bornAlive           Int
  bornDead            Int           @default(0)
  mummified           Int           @default(0)
  totalBorn           Int // = bornAlive + bornDead + mummified
  femalesBornAlive    Int?
  malesBornAlive      Int?
  lowViabilityCount   Int           @default(0)
  totalLitterWeightKg Decimal       @db.Decimal(8, 3)
  avgPigletWeightKg   Decimal?      @db.Decimal(8, 3) // = totalLitterWeightKg / bornAlive
  // Porcentaje pérdidas al nacimiento = (bornDead + mummified) / totalBorn * 100
  penId               String?
  sowWeightKg         Decimal?      @db.Decimal(8, 2)
  employeeId          String?
  notes               String?
  // Stock calculado en tiempo real:
  // currentStock = bornAlive + receivedCount - donatedCount - deathCount - weanedCount
  // El sistema bloquea si llega a negativo (Regla 4)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sow                      Sow                       @relation(fields: [sowId], references: [id])
  serviceEvent             ServiceEvent?             @relation(fields: [serviceEventId], references: [id])
  pen                      Pen?                      @relation(fields: [penId], references: [id])
  piglets                  Piglet[]
  deaths                   PigletDeath[]
  movementsAsOrigin        PigletMovement[]          @relation("MovementOrigin")
  movementsAsDestination   PigletMovement[]          @relation("MovementDestination")
  fosterAsReceiver         FosterEvent[]             @relation("FosterReceiver")
  fosterDonations          FosterDonation[]          @relation("FarrowingAsDonor")
  weaning                  WeaningEvent?
  healthTasks              HealthTask[]
  stockAdjustments         StockAdjustmentRequest[]
  feedRecords              FeedRecord[]
  curativeTreatments       CurativeTreatment[]
  withdrawalPeriods        WithdrawalPeriod[]
  procedimientosMaternidad ProcedimientoMaternidad[]
  necropsias               Necropsia[]

  @@index([tenantId, sowId])
  @@index([tenantId, startDatetime])
  @@map("farrowing_events")
}

model Piglet {
  id          String           @id @default(cuid())
  tenantId    String
  farrowingId String
  identCode   String? // Tatuaje o número de caravana
  identType   PigletIdentType?
  sex         PigletSex?
  weightKg    Decimal?         @db.Decimal(6, 3)
  status      PigletStatus     @default(VIABLE)
  birthDate   DateTime
  isAlive     Boolean          @default(true)
  createdAt   DateTime         @default(now())

  farrowing   FarrowingEvent      @relation(fields: [farrowingId], references: [id])
  deaths      PigletDeath[]
  treatments  CurativeTreatment[]
  withdrawals WithdrawalPeriod[]
  necropsias  Necropsia[]

  @@unique([tenantId, identCode])
  @@index([tenantId, farrowingId])
  @@map("piglets")
}

model PigletDeath {
  id             String           @id @default(cuid())
  tenantId       String
  farrowingId    String
  pigletId       String? // Si se identificó individualmente
  deathDatetime  DateTime
  quantity       Int              @default(1)
  ageAtDeathDays Int? // Calculado automáticamente
  cause          PigletDeathCause
  employeeId     String?
  evidenceUrl    String? // Foto/auditoría (S3)
  createdAt      DateTime         @default(now())

  farrowing FarrowingEvent @relation(fields: [farrowingId], references: [id])
  piglet    Piglet?        @relation(fields: [pigletId], references: [id])

  @@index([tenantId, farrowingId])
  @@map("piglet_deaths")
}

// Adopción: mueve lechones de una cerda donadora a una receptora
model PigletMovement {
  id            String   @id @default(cuid())
  tenantId      String
  originId      String // Cerda donadora
  destinationId String // Cerda receptora
  movementDate  DateTime
  quantity      Int
  employeeId    String?
  createdAt     DateTime @default(now())

  origin      FarrowingEvent @relation("MovementOrigin", fields: [originId], references: [id])
  destination FarrowingEvent @relation("MovementDestination", fields: [destinationId], references: [id])

  @@index([tenantId])
  @@map("piglet_movements")
}

// Nodriza: cerda que recibe lechones de múltiples donadoras
model FosterEvent {
  id                 String   @id @default(cuid())
  tenantId           String
  receiverId         String // Cerda nodriza receptora
  penLocation        String?
  receiveDate        DateTime
  avgAgeAtFosterDays Decimal? @db.Decimal(5, 1)
  createdAt          DateTime @default(now())

  receiver  FarrowingEvent   @relation("FosterReceiver", fields: [receiverId], references: [id])
  donations FosterDonation[]

  @@index([tenantId])
  @@map("foster_events")
}

model FosterDonation {
  id            String @id @default(cuid())
  fosterEventId String
  donorId       String // Cerda donadora
  quantity      Int
  pigletAgeDays Int // Edad de los lechones al momento del traslado

  fosterEvent FosterEvent    @relation(fields: [fosterEventId], references: [id])
  donor       FarrowingEvent @relation("FarrowingAsDonor", fields: [donorId], references: [id])

  @@map("foster_donations")
}

model WeaningEvent {
  id                  String                 @id @default(cuid())
  tenantId            String
  farrowingId         String                 @unique
  weaningDate         DateTime
  lactationDays       Int // Calculado: weaningDate - startDatetime
  pigletsAvailable    Int // Stock calculado antes del destete
  lastMinuteDeaths    Int                    @default(0)
  lastMinuteReceived  Int                    @default(0)
  lastMinuteDonated   Int                    @default(0)
  pigletsWeaned       Int // <= pigletsAvailable
  totalLitterWeightKg Decimal                @db.Decimal(8, 3)
  avgPigletWeightKg   Decimal                @db.Decimal(8, 3) // Calculado
  nurseryBatchId      String?
  sowDestination      SowDisposalDestination @default(GESTATION)
  bodyConditionScore  BodyConditionScore?
  sowWeightKg         Decimal?               @db.Decimal(8, 2)
  employeeId          String?
  notes               String?
  createdAt           DateTime               @default(now())

  farrowing    FarrowingEvent @relation(fields: [farrowingId], references: [id])
  nurseryBatch NurseryBatch?  @relation(fields: [nurseryBatchId], references: [id])

  @@index([tenantId])
  @@map("weaning_events")
}

// Solicitud de ajuste de stock — flujo de aprobación (Regla 2)
model StockAdjustmentRequest {
  id            String                @id @default(cuid())
  tenantId      String
  farrowingId   String
  sowId         String
  currentStock  Int
  correctStock  Int
  reason        String
  notes         String?
  status        StockAdjustmentStatus @default(PENDING)
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNotes   String?
  createdAt     DateTime              @default(now())

  farrowing FarrowingEvent @relation(fields: [farrowingId], references: [id])
  sow       Sow            @relation(fields: [sowId], references: [id])

  @@index([tenantId, status])
  @@map("stock_adjustment_requests")
}

// ================================================================
// MÓDULO 1C: RECRÍA Y ENGORDE
// ================================================================

model NurseryBatch {
  id              String       @id @default(cuid())
  tenantId        String
  batchCode       String // Código generado: "R-2026-W26-001"
  phase           NurseryPhase @default(PHASE_1)
  entryDate       DateTime
  currentCount    Int
  penId           String?
  currentWeightKg Decimal?     @db.Decimal(10, 3)
  avgWeightKg     Decimal?     @db.Decimal(8, 3)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  pen            Pen?           @relation(fields: [penId], references: [id])
  weanings       WeaningEvent[]
  weightRecords  WeightRecord[]
  phaseChanges   PhaseChange[]
  feedRecords    FeedRecord[]
  growingBatches GrowingBatch[]
  sales          BatchSale[]

  @@unique([tenantId, batchCode])
  @@index([tenantId])
  @@map("nursery_batches")
}

model WeightRecord {
  id             String   @id @default(cuid())
  tenantId       String
  nurseryBatchId String?
  growingBatchId String?
  recordDate     DateTime
  totalWeightKg  Decimal  @db.Decimal(10, 3)
  animalCount    Int
  avgWeightKg    Decimal  @db.Decimal(8, 3) // Calculado
  dailyGainKg    Decimal? @db.Decimal(6, 3) // GDP vs pesaje anterior
  employeeId     String?
  createdAt      DateTime @default(now())

  nurseryBatch NurseryBatch? @relation(fields: [nurseryBatchId], references: [id])
  growingBatch GrowingBatch? @relation(fields: [growingBatchId], references: [id])

  @@index([tenantId])
  @@map("weight_records")
}

model PhaseChange {
  id              String            @id @default(cuid())
  tenantId        String
  nurseryBatchId  String
  fromPhase       NurseryPhase
  toPhase         NurseryPhase
  changeDate      DateTime
  reason          PhaseChangeReason
  triggerWeightKg Decimal?          @db.Decimal(8, 3)
  employeeId      String?
  notes           String?
  createdAt       DateTime          @default(now())

  nurseryBatch NurseryBatch @relation(fields: [nurseryBatchId], references: [id])

  @@index([tenantId])
  @@map("phase_changes")
}

model GrowingBatch {
  id             String   @id @default(cuid())
  tenantId       String
  batchCode      String
  nurseryBatchId String?
  entryDate      DateTime
  entryWeightKg  Decimal  @db.Decimal(10, 3) // Peso total al ingreso
  currentCount   Int
  penId          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Campos Engorde extendidos
  sitio               String? // Sitio / ubicación
  procedencia         String             @default("RECRIA_PROPIA") // RECRIA_PROPIA | COMPRA_EXTERNA
  avgAgeAtEntryDays   Int? // Edad media al ingreso (días)
  targetWeightKg      Decimal?           @db.Decimal(8, 2) // Peso objetivo de salida (default 120)
  employeeId          String? // Responsable
  observations        String?
  status              String             @default("ACTIVE") // ACTIVE | CLOSED
  closedAt            DateTime?
  closedReason        String?
  // Fase 9: modalidad, costo de ingreso y curva
  modalidad           String             @default("PROPIO") // PROPIO | INTEGRADO
  integradorId        String? // contraparte que provee animales y/o alimento
  pagoIntegracion     String? // POR_KG_PRODUCIDO | POR_ANIMAL_DIA | POR_CABEZA
  tarifaIntegracionGs BigInt?
  alimentoLoProvee    String             @default("PROPIO") // PROPIO | INTEGRADOR
  sexo                String? // MACHOS_CASTRADOS | HEMBRAS | MIXTO
  genetica            String?
  costoIngresoGs      BigInt? // lo pagado por los animales (compra); null = según Parámetros
  curvaId             String?
  withdrawalPeriods   WithdrawalPeriod[]

  nurseryBatch      NurseryBatch?      @relation(fields: [nurseryBatchId], references: [id])
  pen               Pen?               @relation(fields: [penId], references: [id])
  weightRecords     WeightRecord[]
  feedRecords       FeedRecord[]
  sales             BatchSale[]
  deaths            GrowingDeath[]
  outgoingTransfers GrowingTransfer[]  @relation("TransferSource")
  incomingTransfers GrowingTransfer[]  @relation("TransferTarget")
  otherExits        GrowingOtherExit[]

  @@unique([tenantId, batchCode])
  @@index([tenantId])
  @@map("growing_batches")
}

model GrowingDeath {
  id                String   @id @default(cuid())
  tenantId          String
  growingBatchId    String
  deathDate         DateTime
  deathTime         String? // "HH:MM"
  count             Int      @default(1)
  cause             String // RESPIRATORY|DIGESTIVE|ACCIDENT|RENAL_URINARY|MULBERRY_HEART|OTHER
  employeeId        String?
  estimatedWeightKg Decimal? @db.Decimal(8, 2)
  notes             String?
  createdAt         DateTime @default(now())

  growingBatch GrowingBatch @relation(fields: [growingBatchId], references: [id])

  @@index([tenantId, deathDate])
  @@map("growing_deaths")
}

model GrowingTransfer {
  id            String   @id @default(cuid())
  tenantId      String
  sourceBatchId String
  targetBatchId String? // nulo si destino es externo
  targetSite    String?
  transferDate  DateTime
  count         Int
  totalWeightKg Decimal? @db.Decimal(10, 3)
  avgWeightKg   Decimal? @db.Decimal(8, 3)
  reason        String // SPACE_PRESSURE|BATCH_REBALANCING|HEALTH_ISSUE|OTHER
  employeeId    String?
  createdAt     DateTime @default(now())

  sourceBatch GrowingBatch  @relation("TransferSource", fields: [sourceBatchId], references: [id])
  targetBatch GrowingBatch? @relation("TransferTarget", fields: [targetBatchId], references: [id])

  @@index([tenantId, transferDate])
  @@map("growing_transfers")
}

model GrowingOtherExit {
  id                String   @id @default(cuid())
  tenantId          String
  growingBatchId    String
  exitType          String // DISCARD|HOSPITAL|SAMPLE|DONATION|OTHER
  exitDate          DateTime
  count             Int
  estimatedWeightKg Decimal? @db.Decimal(8, 2)
  reason            String
  employeeId        String?
  createdAt         DateTime @default(now())

  growingBatch GrowingBatch @relation(fields: [growingBatchId], references: [id])

  @@index([tenantId, exitDate])
  @@map("growing_other_exits")
}

model BatchSale {
  id             String   @id @default(cuid())
  tenantId       String
  nurseryBatchId String?
  growingBatchId String?
  saleDate       DateTime
  animalCount    Int
  totalWeightKg  Decimal  @db.Decimal(10, 3)
  pricePerKg     Decimal  @db.Decimal(10, 2)
  totalAmount    Decimal  @db.Decimal(12, 2)
  buyerName      String?
  transferGuide  String? // Guía de traslado
  employeeId     String?
  createdAt      DateTime @default(now())

  nurseryBatch NurseryBatch? @relation(fields: [nurseryBatchId], references: [id])
  growingBatch GrowingBatch? @relation(fields: [growingBatchId], references: [id])

  @@index([tenantId])
  @@map("batch_sales")
}

// ================================================================
// MÓDULO 2: ALIMENTACIÓN (transversal a todas las fases)
// ================================================================

// Tipos de alimento: Gestación / Lactancia hembra / Pre-starter /
// Fase 1 / Fase 2 / Engorde — configurables por granja
model FeedType {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  phase     String // GESTATION | LACTATION | PRE_STARTER | PHASE_1 | PHASE_2 | GROWING
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  productoBalanceadoId String? // FK a ProductoInventario (categoria=BALANCEADO) — fuente única de stock de esta etapa

  feedRecords        FeedRecord[]
  productoBalanceado ProductoInventario? @relation(fields: [productoBalanceadoId], references: [id])

  @@unique([tenantId, phase])
  @@index([tenantId])
  @@map("feed_types")
}

model FeedRecord {
  id             String   @id @default(cuid())
  tenantId       String
  feedTypeId     String
  farrowingId    String? // Para cerdas en maternidad / lechones pre-starter
  nurseryBatchId String? // Para lotes de recría
  growingBatchId String? // Para lotes de engorde
  recordDate     DateTime
  quantityKg     Decimal  @db.Decimal(10, 3)
  employeeId     String?
  isSynced       Boolean  @default(true) // false = pendiente de sync offline
  createdAt      DateTime @default(now())

  feedType     FeedType        @relation(fields: [feedTypeId], references: [id])
  farrowing    FarrowingEvent? @relation(fields: [farrowingId], references: [id])
  nurseryBatch NurseryBatch?   @relation(fields: [nurseryBatchId], references: [id])
  growingBatch GrowingBatch?   @relation(fields: [growingBatchId], references: [id])

  @@index([tenantId, recordDate])
  @@map("feed_records")
}

// ================================================================
// MÓDULO 3: BALANCEADO (BAL)
// ================================================================

// Detalle de análisis nutricional/comercial de un lote de materia prima —
// LoteInventario (catálogo único) sigue siendo la única fuente de verdad de
// cantidad/vencimiento; esta tabla solo agrega los campos que no aplican a
// lotes de vacunas/suplementos/medicamentos (ver decisión de arquitectura).
// Una fórmula por tipo de alimento, con historial de versiones
// REGLA CRÍTICA 1: Solo el Veterinario Jefe puede aprobar cambios de fórmula.
// La IA sugiere pero NUNCA modifica. approvedById es obligatorio para activar.
// Metas nutricionales por fase — el sistema compara y alerta si la fórmula queda por debajo
// ================================================================
// MÓDULO 4: LOGÍSTICA
// ================================================================

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  ruc       String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  tenantId        String
  supplierId      String
  orderDate       DateTime
  expectedDate    DateTime?
  status          PurchaseOrderStatus @default(DRAFT)
  isAutoGenerated Boolean             @default(false) // Generada por proyección BAL
  totalAmount     Decimal?            @db.Decimal(12, 2)
  notes           String?
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productoId      String // FK lógica a ProductoInventario — sin @relation, módulo sin implementar aún
  quantityKg      Decimal  @db.Decimal(12, 3)
  pricePerKg      Decimal? @db.Decimal(10, 4)
  totalAmount     Decimal? @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  tenantId        String
  purchaseOrderId String?
  supplierId      String
  receiptDate     DateTime
  invoiceNumber   String?
  status          GoodsReceiptStatus @default(COMPLETE)
  receivedById    String
  createdAt       DateTime           @default(now())

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  items         GoodsReceiptItem[]

  @@index([tenantId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String  @id @default(cuid())
  goodsReceiptId   String
  loteInventarioId String? // FK lógica a LoteInventario — sin @relation, módulo sin implementar aún
  quantityKg       Decimal @db.Decimal(12, 3)
  pricePerKg       Decimal @db.Decimal(10, 4)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])

  @@map("goods_receipt_items")
}

// Traslado de producto terminado del BAL al sector porcino
model Transfer {
  id           String    @id @default(cuid())
  tenantId     String
  fromLocation String?
  toLocation   String?
  transferDate DateTime
  createdById  String
  notes        String?
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  items TransferItem[]

  @@index([tenantId])
  @@map("transfers")
}

model TransferItem {
  id         String  @id @default(cuid())
  transferId String
  feedTypeId String?
  quantityKg Decimal @db.Decimal(12, 3)

  transfer Transfer @relation(fields: [transferId], references: [id])

  @@map("transfer_items")
}

// ================================================================
// MÓDULO 5: RRHH
// ================================================================

model Employee {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String?   @unique
  cedula       String? // cifrada (AES-256-GCM, prefijo k1:) — Fase 2.4
  cedulaHash   String? // HMAC-SHA256 para buscar por cédula sin descifrar
  name         String
  cargo        String?
  category     String?
  position     String?
  sector       String? // gestacion | maternidad | recria | engorde | veterinario | admin | all
  iniciales    String?
  colorBg      String?
  colorBorder  String?
  colorText    String?
  entryDate    DateTime
  exitDate     DateTime?
  isActive     Boolean   @default(true)
  baseSalaryGs Decimal   @default(0) @db.Decimal(14, 0)
  createdAt    DateTime  @default(now())

  attendances AttendanceRecord[]
  leaves      LeaveRecord[]
  payrolls    PayrollRecord[]

  @@index([tenantId])
  @@index([tenantId, cedulaHash])
  @@map("employees")
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  workDate    DateTime @db.Date
  isPresent   Boolean  @default(true)
  hoursWorked Decimal? @db.Decimal(4, 2)
  notes       String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, workDate])
  @@index([tenantId])
  @@map("attendance_records")
}

model LeaveRecord {
  id           String   @id @default(cuid())
  tenantId     String
  employeeId   String
  startDate    DateTime
  endDate      DateTime
  leaveType    String // VACATION | SICK | MATERNITY | OTHER
  approvedById String?
  notes        String?
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@map("leave_records")
}

model PayrollRecord {
  id           String        @id @default(cuid())
  tenantId     String
  employeeId   String
  periodStart  DateTime
  periodEnd    DateTime
  baseSalaryGs Decimal       @db.Decimal(14, 0)
  bonusesGs    Decimal       @default(0) @db.Decimal(14, 0)
  deductionsGs Decimal       @default(0) @db.Decimal(14, 0)
  ipsEmployee  Decimal       @default(0) @db.Decimal(14, 0) // 9% del salario
  ipsEmployer  Decimal       @default(0) @db.Decimal(14, 0) // 16.5% del salario
  netAmountGs  Decimal       @db.Decimal(14, 0)
  status       PayrollStatus @default(DRAFT)
  approvedById String?
  paidAt       DateTime?
  receiptUrl   String? // PDF en S3
  createdAt    DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@map("payroll_records")
}

// ================================================================
// MÓDULO 6: FINANCIERO / ADMINISTRATIVO
// ================================================================

model Sale {
  id            String   @id @default(cuid())
  tenantId      String
  saleDate      DateTime
  description   String?
  amountGs      Decimal  @db.Decimal(14, 0)
  category      String // PIGLET_SALE | SOW_SALE | BATCH_SALE | SLAUGHTER | OTHER
  batchSaleId   String?  @unique
  invoiceNumber String?
  buyerName     String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([tenantId, saleDate])
  @@map("sales")
}

model Expense {
  id            String   @id @default(cuid())
  tenantId      String
  expenseDate   DateTime
  description   String
  amountGs      Decimal  @db.Decimal(14, 0)
  category      String // FEED | MEDICINE | SALARY | MAINTENANCE | INPUT | OTHER
  supplierId    String?
  invoiceNumber String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([tenantId, expenseDate])
  @@map("expenses")
}

// ================================================================
// MÓDULO 7: SANIDAD
// ================================================================

model Medicine {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  activeIngredient String?
  defaultDoseMl    Decimal? @db.Decimal(8, 3)
  withdrawalDays   Int      @default(0)
  isActive         Boolean  @default(true)

  stocks             MedicineStock[]
  curativeTreatments CurativeTreatment[]
  withdrawalPeriods  WithdrawalPeriod[]
  protocolTasks      HealthProtocolTask[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("medicines")
}

model MedicineStock {
  id         String    @id @default(cuid())
  tenantId   String
  medicineId String
  lotCode    String?
  expiryDate DateTime?
  quantityMl Decimal   @db.Decimal(10, 3)
  currentQty Decimal   @db.Decimal(10, 3)
  createdAt  DateTime  @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@index([tenantId])
  @@map("medicine_stocks")
}

// Configuración global del protocolo sanitario — se define una vez por granja
model HealthProtocolConfig {
  id                     String  @id @default(cuid())
  tenantId               String  @unique
  tailDockingEnabled     Boolean @default(true)
  tailDockingDayOfLife   Int     @default(1)
  toothClippingEnabled   Boolean @default(true)
  toothClippingDayOfLife Int     @default(1)
  castrationEnabled      Boolean @default(true)
  castrationDayOfLife    Int     @default(7)
  ironInjectionEnabled   Boolean @default(true)
  ironDayOfLife          Int     @default(3)
  ironDoseMl             Decimal @default(1.0) @db.Decimal(6, 3)
  ironMedicineId         String?

  vaccinationTasks HealthProtocolTask[]

  @@map("health_protocol_configs")
}

// Cada vacuna o procedimiento en el protocolo
model HealthProtocolTask {
  id         String            @id @default(cuid())
  protocolId String
  taskType   HealthTaskType    @default(VACCINATION)
  taskName   String
  medicineId String?
  dayOfLife  Int // Día de vida en que se aplica
  doseMl     Decimal?          @db.Decimal(8, 3)
  route      VaccinationRoute?
  isActive   Boolean           @default(true)
  sortOrder  Int               @default(0)

  protocol    HealthProtocolConfig @relation(fields: [protocolId], references: [id])
  medicine    Medicine?            @relation(fields: [medicineId], references: [id])
  healthTasks HealthTask[]

  @@map("health_protocol_tasks")
}

// Tarea generada automáticamente al registrar un parto
model HealthTask {
  id             String    @id @default(cuid())
  tenantId       String
  farrowingId    String
  protocolTaskId String
  dueDate        DateTime
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  assignedToId   String? // Usuario responsable asignado por jefe de producción
  createdAt      DateTime  @default(now())

  farrowing    FarrowingEvent        @relation(fields: [farrowingId], references: [id])
  protocolTask HealthProtocolTask    @relation(fields: [protocolTaskId], references: [id])
  completion   HealthTaskCompletion?
  assignedTo   User?                 @relation("AssignedHealthTasks", fields: [assignedToId], references: [id])

  @@index([tenantId, isCompleted, dueDate])
  @@index([tenantId, assignedToId])
  @@map("health_tasks")
}

model HealthTaskCompletion {
  id                   String    @id @default(cuid())
  healthTaskId         String    @unique
  applicationDate      DateTime
  ageAtApplicationDays Int?
  quantityApplied      Int
  productLot           String?
  productExpiry        DateTime?
  medicineStockId      String?
  employeeId           String?
  notes                String?
  createdAt            DateTime  @default(now())

  healthTask HealthTask @relation(fields: [healthTaskId], references: [id])

  @@map("health_task_completions")
}

// Tratamiento curativo individual (Diagnóstico → medicamento → período de retiro)
// sowId agregado para cubrir también cerdas adultas (antes solo lechones/camadas)
// — mismo modelo, misma lógica de retiro, sin duplicar en un modelo paralelo.
model CurativeTreatment {
  id                   String            @id @default(cuid())
  tenantId             String
  farrowingId          String?
  pigletId             String?
  sowId                String?
  diagnosisType        DiagnosisType
  diagnosisNotes       String?
  motivoClinico        String? // texto libre, complementa diagnosisType para cerdas adultas
  medicineId           String
  doseMl               Decimal           @db.Decimal(8, 3)
  animalsAffected      Int
  treatmentDays        Int               @default(1)
  startDate            DateTime
  endDate              DateTime?
  withdrawalDays       Int               @default(0)
  estado               EstadoTratamiento @default(ACTIVO)
  fechaSeguimiento     DateTime? // dispara recordatorio si estado = EN_SEGUIMIENTO
  respuestaSeguimiento String?
  employeeId           String?
  createdAt            DateTime          @default(now())

  medicine          Medicine           @relation(fields: [medicineId], references: [id])
  farrowing         FarrowingEvent?    @relation(fields: [farrowingId], references: [id])
  piglet            Piglet?            @relation(fields: [pigletId], references: [id])
  sow               Sow?               @relation(fields: [sowId], references: [id])
  withdrawalPeriods WithdrawalPeriod[]

  @@index([tenantId])
  @@map("curative_treatments")
}

// REGLA 5: Período de retiro activo bloquea destete y venta
model WithdrawalPeriod {
  id             String   @id @default(cuid())
  tenantId       String
  growingBatchId String? // Fase 9: carencia de un lote de engorde (bloquea la venta)
  animales       Int? // Fase 9: tratamiento de lote
  mlAplicados    Decimal? @db.Decimal(10, 2)
  costoGs        BigInt? // costo del tratamiento (suma al costo del lote)
  pigletId       String?
  farrowingId    String?
  sowId          String?
  medicineId     String
  treatmentId    String?
  withdrawalDays Int
  startDate      DateTime
  endDate        DateTime // startDate + withdrawalDays
  isActive       Boolean  @default(true)

  medicine     Medicine           @relation(fields: [medicineId], references: [id])
  piglet       Piglet?            @relation(fields: [pigletId], references: [id])
  sow          Sow?               @relation(fields: [sowId], references: [id])
  treatment    CurativeTreatment? @relation(fields: [treatmentId], references: [id])
  farrowing    FarrowingEvent?    @relation(fields: [farrowingId], references: [id])
  growingBatch GrowingBatch?      @relation(fields: [growingBatchId], references: [id])

  @@index([tenantId, isActive, endDate])
  @@map("withdrawal_periods")
}

// Sanidad de maternidad: descolmillado, corte de cola, corte de ombligo,
// hierro, castración — se carga por camada completa por defecto.
model ProcedimientoMaternidad {
  id                         String                      @id @default(cuid())
  tenantId                   String
  farrowingId                String
  procedimiento              ProcedimientoMaternidadTipo
  cantidadLechonesProcesados Int
  edadDiasAlProcedimiento    Int
  observacionesTecnica       String?
  fecha                      DateTime
  responsableId              String
  createdAt                  DateTime                    @default(now())

  farrowing FarrowingEvent @relation(fields: [farrowingId], references: [id])

  @@index([tenantId, farrowingId])
  @@map("procedimientos_maternidad")
}

// Necropsias / bajas — investigación de causa de muerte. bajaConfirmaBrote
// es una confirmación administrativa manual, separada del disparador
// automático del heatmap de brotes (≥3 casos misma causa/galpón/7 días).
model Necropsia {
  id                     String    @id @default(cuid())
  tenantId               String
  sowId                  String?
  boarId                 String?
  farrowingId            String?
  pigletId               String?
  causaSanitariaPresunta String
  seRealizoNecropsia     Boolean   @default(false)
  hallazgos              String?
  galpon                 String?
  bajaConfirmaBrote      Boolean   @default(false)
  bajaConfirmaBrotePor   String? // userId — validado en servicio: solo Super Admin / Farm Admin
  bajaConfirmaBroteFecha DateTime?
  fecha                  DateTime
  responsableId          String
  createdAt              DateTime  @default(now())

  sow       Sow?            @relation(fields: [sowId], references: [id])
  boar      Boar?           @relation(fields: [boarId], references: [id])
  farrowing FarrowingEvent? @relation(fields: [farrowingId], references: [id])
  piglet    Piglet?         @relation(fields: [pigletId], references: [id])

  @@index([tenantId, fecha])
  @@index([tenantId, galpon, causaSanitariaPresunta])
  @@map("necropsias")
}

// ================================================================
// MÓDULO 9: BOT DE WHATSAPP
// ================================================================

// Sesión de conversación por número de teléfono
// Timeout: 30 minutos de inactividad = sesión cancelada (Regla 6)
model WhatsAppSession {
  id             String                @id @default(cuid())
  tenantId       String
  userId         String
  phoneNumber    String
  status         WhatsAppSessionStatus @default(ACTIVE)
  context        Json                  @default("{}") // Estado de la conversación en curso
  currentStep    String? // Paso actual del flujo ("ASK_BORN_ALIVE", etc.)
  lastActivityAt DateTime              @default(now())
  expiresAt      DateTime

  messages WhatsAppMessage[]

  @@index([phoneNumber, status])
  @@index([tenantId])
  @@map("whatsapp_sessions")
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  sessionId   String
  direction   String // "IN" | "OUT"
  messageType String // "text" | "audio" | "image"
  content     String   @db.Text
  transcript  String?  @db.Text // Transcripción si es audio (Whisper)
  waMessageId String? // ID del mensaje de Meta
  createdAt   DateTime @default(now())

  session WhatsAppSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("whatsapp_messages")
}

// ================================================================
// ALERTAS Y NOTIFICACIONES
// ================================================================

model Alert {
  id         String        @id @default(cuid())
  tenantId   String
  alertType  AlertType
  severity   AlertSeverity @default(WARNING)
  title      String
  body       String
  entityId   String? // ID de la entidad relacionada
  entityType String? // "SOW" | "BATCH" | "FORMULA" | "HEALTH_TASK"
  isRead     Boolean       @default(false)
  isResolved Boolean       @default(false)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([tenantId, isResolved, createdAt])
  @@index([tenantId, alertType])
  @@map("alerts")
}

model NotificationPreference {
  id          String              @id @default(cuid())
  userId      String              @unique
  tenantId    String
  channel     NotificationChannel @default(BOTH)
  // Alertas críticas siempre se envían por ambos canales (ignorando preferences)
  preferences Json                @default("{}") // { "PIGLETS_OVERDUE_WEANING": "PUSH", ... }
  updatedAt   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // "android" | "ios" | "web"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

// ================================================================
// MARKETPLACE — Proveedores de insumos y medicamentos
// ================================================================

enum MarketplacePedidoEstado {
  PENDIENTE
  CONFIRMADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum MarketplaceCategoria {
  VACUNA
  MEDICAMENTO
  INSUMO
  ALIMENTO
  EQUIPAMIENTO
  OTRO
}

model MarketplaceVendor {
  id             String   @id @default(cuid())
  empresaNombre  String
  ruc            String?
  contactoNombre String?
  email          String?
  telefono       String?
  direccion      String?
  ciudad         String?
  logoUrl        String?
  descripcion    String?  @db.Text
  isActive       Boolean  @default(true)
  isApproved     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productos MarketplaceProducto[]
  pedidos   MarketplacePedido[]

  @@map("marketplace_vendors")
}

model MarketplaceProducto {
  id                 String               @id @default(cuid())
  vendorId           String
  categoria          MarketplaceCategoria @default(VACUNA)
  nombreProducto     String
  descripcion        String?              @db.Text
  principioActivo    String?
  enfermedadObjetivo String?
  viaAplicacion      String?
  dosisMl            Decimal?             @db.Decimal(8, 3)
  presentacion       String? // "50ml/vial", "10 dosis/caja"
  fichaTecnicaUrl    String?
  stockDisponible    Int                  @default(0)
  unidadMedida       String               @default("dosis") // dosis, ml, kg, unidad
  precioGs           Decimal              @db.Decimal(14, 0)
  precioUsd          Decimal?             @db.Decimal(10, 2)
  paisProcedencia    String?
  requiereReceta     Boolean              @default(false)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  vendor      MarketplaceVendor       @relation(fields: [vendorId], references: [id])
  pedidoItems MarketplacePedidoItem[]

  @@index([vendorId, isActive])
  @@index([categoria, isActive])
  @@map("marketplace_productos")
}

model MarketplacePedido {
  id               String                  @id @default(cuid())
  tenantId         String // Tenant comprador
  vendorId         String
  estado           MarketplacePedidoEstado @default(PENDIENTE)
  totalGs          Decimal                 @db.Decimal(14, 0)
  notas            String?
  direccionEntrega String?
  creadoPorId      String? // userId del comprador
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  vendor MarketplaceVendor       @relation(fields: [vendorId], references: [id])
  items  MarketplacePedidoItem[]

  @@index([tenantId, estado])
  @@map("marketplace_pedidos")
}

model MarketplacePedidoItem {
  id         String  @id @default(cuid())
  pedidoId   String
  productoId String
  cantidad   Int
  precioGs   Decimal @db.Decimal(14, 0)

  pedido   MarketplacePedido   @relation(fields: [pedidoId], references: [id])
  producto MarketplaceProducto @relation(fields: [productoId], references: [id])

  @@map("marketplace_pedido_items")
}

// ================================================================
// MÓDULO TAREAS — Órdenes de trabajo automáticas y manuales
// ================================================================

model Task {
  id               String    @id @default(cuid())
  tenantId         String
  tipo             String // parto-esperado | diagnostico-prenez | vacuna-gestacion | vacuna-lechones
  // hierro-fe | destete | pesaje | cambio-fase | tratamiento-curativo
  // limpieza-bebederos | desinfeccion-corral | limpieza-semanal
  // control-temperatura | alimentacion
  sector           String // gestacion | maternidad | iniciacion | engorde | granja
  alcance          String // animal | camada | lote | sala | granja
  titulo           String
  descripcion      String
  instrucciones    String?
  prioridad        String // urgente | hoy | programada
  fechaVencimiento DateTime
  fechaCompletada  DateTime?

  // Target (solo uno aplica)
  animalId       String? // sowId
  farrowingId    String?
  nurseryBatchId String?
  growingBatchId String?
  targetLabel    String? // Nombre legible del target (ej: "Cerda 4480 · Corral 14")

  // Completion
  completadaPor String?
  notas         String?
  pospuestas    Int     @default(0)

  // Responsable
  responsableNombre String? // "Veterinario" (puesto, nunca nombre personal)
  responsableKey    String? // "erwin-segovia" | "bartolome-vera" | "graciela-duarte" | "alex-almada"

  // Generation
  generadaPor String  @default("sistema") // sistema | manual
  disparador  String? // "parto-{farrowingId}" | "servicio-{serviceEventId}"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, fechaVencimiento])
  @@index([tenantId, sector, fechaVencimiento])
  @@index([tenantId, tipo, farrowingId])
  @@map("tasks")
}

// ── MÓDULO SANIDAD ────────────────────────────────────────────────────────────

enum CategoriaProducto {
  VACUNA
  SUPLEMENTO
  MEDICAMENTO
  BALANCEADO
  EQUIPAMIENTO
}

enum UnidadMedida {
  DOSIS
  ML
  KG
  UNIDAD
  SACO
}

// Catálogo único de inventario (Logística) — cubre vacunas/suplementos/medicamentos
// (Sanidad) y, desde la Fase 2, también materia prima y balanceado. Sigue mapeado a
// las tablas físicas "vacunas"/"lotes_vacunas" — es un renombrado lógico, sin
// migración de datos.
model ProductoInventario {
  id                    String                 @id @default(cuid())
  tenantId              String
  nombre                String
  enfermedad            String
  sectorDestino         String                 @map("sector_destino") // cerda | lechon | lote | verraco | plantel (ex "categoria" — sector destino de la vacuna; columna física renombrada de "categoria" a "sector_destino")
  categoria             CategoriaProducto      @default(VACUNA)
  codigo                String? // V-001 | S-001 | M-001 | MP-001 | B-001 | E-001 — inmutable, nunca se reasigna
  unidadMedida          UnidadMedida           @default(DOSIS)
  stockMinimo           Int? // umbral manual de stock crítico (Suplemento/Medicamento/Materia Prima/Balanceado)
  viaAplicacion         String                 @default("IM") // IM | SC | oral | intranasal
  dosisMl               Decimal                @default(2) @db.Decimal(6, 2)
  intervaloRefuerzo     Int? // días hasta refuerzo
  criticidad            String                 @default("alta") // alta | media | baja
  bloqueoServicio       Boolean                @default(false)
  descarteHorasApertura Int? // horas hasta descartar un vial ya abierto (multidosis); null = no forzar por tiempo
  observaciones         String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  lotes                 LoteInventario[]
  protocoloItems        ProtocoloItem[]
  eventosVacunacion     EventoVacunacion[]
  aplicaciones          AplicacionVacuna[]
  feedTypesBalanceado   FeedType[]
  movimientos           MovimientoInventario[]

  @@index([tenantId])
  @@index([tenantId, categoria])
  @@map("vacunas")
}

model LoteInventario {
  id               String                 @id @default(cuid())
  tenantId         String
  vacunaId         String
  numeroLote       String
  proveedor        String?
  fechaVencimiento DateTime
  fechaIngreso     DateTime               @default(now())
  cantidadInicial  Decimal                @db.Decimal(12, 3)
  cantidadActual   Decimal                @db.Decimal(12, 3)
  costoUnitario    Decimal?               @db.Decimal(12, 4) // costo por unidad de medida del producto (₲/dosis, ₲/ml, ₲/kg) — para "cuánto me sale cada producto"
  abierto          Boolean                @default(false)
  fechaApertura    DateTime? // cuándo se abrió el vial — junto con vacuna.descarteHorasApertura define el descarte por tiempo
  abiertoPorId     String? // userId que lo abrió
  observaciones    String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  vacuna           ProductoInventario     @relation(fields: [vacunaId], references: [id])
  aplicaciones     AplicacionVacuna[]
  movimientos      MovimientoInventario[]

  @@index([tenantId, vacunaId])
  @@map("lotes_vacunas")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

enum OrigenMovimiento {
  VACUNACION
  TRATAMIENTO
  MATERNIDAD
  ALIMENTACION
  COMPRA
  AJUSTE_MANUAL
}

// Historial de toda entrada/salida de inventario — audita (no reemplaza) el
// descuento/incremento directo que ya hace cada flujo sobre LoteInventario.
model MovimientoInventario {
  id           String           @id @default(cuid())
  tenantId     String
  productoId   String
  loteId       String?
  tipo         TipoMovimiento
  cantidad     Decimal          @db.Decimal(12, 3)
  origen       OrigenMovimiento
  referenciaId String?
  fecha        DateTime         @default(now())

  producto ProductoInventario @relation(fields: [productoId], references: [id])
  lote     LoteInventario?    @relation(fields: [loteId], references: [id])

  @@index([tenantId, productoId, fecha])
  @@map("movimientos_inventario")
}

model ProtocoloSanitario {
  id          String          @id @default(cuid())
  tenantId    String
  nombre      String
  fase        String // gestacion | maternidad | iniciacion | engorde | reproductores
  tipoAnimal  String // cerda | lechon | lote | plantel
  descripcion String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  items       ProtocoloItem[]

  @@index([tenantId])
  @@map("protocolos_sanitarios")
}

model ProtocoloItem {
  id              String             @id @default(cuid())
  tenantId        String
  protocoloId     String
  vacunaId        String
  diaCiclo        Int
  disparador      String // parto | servicio | destete | ingreso-lote
  esObligatorio   Boolean            @default(true)
  bloqueoServicio Boolean            @default(false)
  descripcion     String?
  createdAt       DateTime           @default(now())
  protocolo       ProtocoloSanitario @relation(fields: [protocoloId], references: [id])
  vacuna          ProductoInventario @relation(fields: [vacunaId], references: [id])

  @@index([tenantId, protocoloId])
  @@map("protocolo_items")
}

model EventoVacunacion {
  id              String             @id @default(cuid())
  tenantId        String
  protocoloItemId String?
  vacunaId        String
  sector          String
  fecha           DateTime
  animalId        String?
  farrowingId     String?
  nurseryBatchId  String?
  growingBatchId  String?
  targetLabel     String?
  dosisNecesarias Int                @default(1)
  estado          String             @default("pendiente") // pendiente | aplicado | retrasado | omitido
  disparador      String?
  sectorAlAplicar String? // snapshot de "sector" al momento de aplicar (no cambia si el animal se traslada después)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  vacuna          ProductoInventario @relation(fields: [vacunaId], references: [id])
  aplicaciones    AplicacionVacuna[]

  @@index([tenantId, fecha])
  @@index([tenantId, vacunaId, estado])
  @@map("eventos_vacunacion")
}

model AplicacionVacuna {
  id                String             @id @default(cuid())
  tenantId          String
  eventoId          String
  loteVacunaId      String?
  vacunaId          String
  dosisAplicadas    Int
  fechaAplicacion   DateTime
  responsable       String
  observaciones     String?
  grupoAplicacionId String? // agrupa todas las filas creadas en una misma acción de "Registrar aplicación" (bulk)
  createdAt         DateTime           @default(now())
  evento            EventoVacunacion   @relation(fields: [eventoId], references: [id])
  loteVacuna        LoteInventario?    @relation(fields: [loteVacunaId], references: [id])
  vacuna            ProductoInventario @relation(fields: [vacunaId], references: [id])

  @@index([tenantId, eventoId])
  @@index([tenantId, grupoAplicacionId])
  @@map("aplicaciones_vacunas")
}

// ================================================================
// PLATAFORMA — Identidad, organizaciones, membresías y unidades (Fase 1)
// Organización = Tenant (tabla "tenants") · Perfil = User (tabla "users").
// Las FK hacia tablas existentes son texto (cuid); los ids propios, uuid.
// ================================================================

enum TipoRegistro {
  COMPRADOR
  INDIVIDUAL
  EMPRESA
  VENDEDOR
}

enum TipoOrganizacion {
  INDIVIDUAL
  EMPRESA
  VENDEDOR
}

enum EstadoOrganizacion {
  ACTIVA
  SUSPENDIDA
  EN_BAJA
}

enum EstadoVerificacion {
  NO_APLICA
  PENDIENTE
  VERIFICADA
  RECHAZADA
}

enum EstadoMiembro {
  ACTIVO
  SUSPENDIDO
}

enum Alcance {
  TODAS
  SELECCION
}

enum EfectoPermiso {
  PERMITIR
  DENEGAR
}

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  REVOCADA
  VENCIDA
}

enum TipoAcceso {
  NORMAL
  GESTIONADA // cuenta creada por el Administrador General para un operario sin correo
}

enum TipoUnidad {
  GRANJA
  COMUN
  OTRA
}

model Granja {
  id             String   @id @default(cuid())
  organizacionId String   @map("organizacion_id")
  codigo         String // "MISIONES", "SAN-COSME"
  nombre         String
  departamento   String?
  distrito       String?
  activa         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  organizacion Tenant          @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  sectores     FarmLocation[]
  unidades     UnidadNegocio[]
  miembros     MiembroGranja[]

  @@unique([organizacionId, codigo])
  @@index([organizacionId])
  @@map("granja")
}

model UnidadNegocio {
  id             String     @id @default(uuid()) @db.Uuid
  organizacionId String     @map("organizacion_id")
  codigo         String // "GRANJA-MISIONES", "COMUN"
  nombre         String
  tipo           TipoUnidad
  granjaId       String?    @map("granja_id")
  activa         Boolean    @default(true)

  organizacion Tenant          @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  granja       Granja?         @relation(fields: [granjaId], references: [id])
  miembros     MiembroUnidad[]

  @@unique([organizacionId, codigo])
  @@index([organizacionId])
  @@map("unidad_negocio")
}

model Miembro {
  id              String        @id @default(uuid()) @db.Uuid
  organizacionId  String        @map("organizacion_id")
  userId          String        @map("user_id")
  rolId           String?       @map("rol_id") @db.Uuid
  esPropietario   Boolean       @default(false) @map("es_propietario") // Administrador General
  cargo           String? // texto visible: "Encargada de Maternidad"
  estado          EstadoMiembro @default(ACTIVO)
  alcanceGranjas  Alcance       @default(TODAS) @map("alcance_granjas")
  alcanceUnidades Alcance       @default(TODAS) @map("alcance_unidades")
  limiteCompraGs  BigInt?       @map("limite_compra_gs") // null = sin límite (solo propietario); 0 = toda compra requiere aprobación
  invitadoPor     String?       @map("invitado_por")
  createdAt       DateTime      @default(now()) @map("created_at")

  organizacion   Tenant           @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  perfil         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rol            Rol?             @relation(fields: [rolId], references: [id])
  granjas        MiembroGranja[]
  unidades       MiembroUnidad[]
  permisosAjuste MiembroPermiso[]

  @@unique([organizacionId, userId])
  @@index([userId])
  @@map("miembro")
}

model MiembroGranja {
  miembroId String @map("miembro_id") @db.Uuid
  granjaId  String @map("granja_id")

  miembro Miembro @relation(fields: [miembroId], references: [id], onDelete: Cascade)
  granja  Granja  @relation(fields: [granjaId], references: [id], onDelete: Cascade)

  @@id([miembroId, granjaId])
  @@map("miembro_granja")
}

model MiembroUnidad {
  miembroId String @map("miembro_id") @db.Uuid
  unidadId  String @map("unidad_id") @db.Uuid

  miembro Miembro       @relation(fields: [miembroId], references: [id], onDelete: Cascade)
  unidad  UnidadNegocio @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  @@id([miembroId, unidadId])
  @@map("miembro_unidad")
}

// Roles editables por organización. Los 14 roles fijos de la tabla "roles"
// quedan como legado hasta que la Fase 7 reemplace los chequeos hardcodeados.
model Rol {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String?  @map("organizacion_id") // null = plantilla global del sistema
  codigo         String
  nombre         String
  descripcion    String?
  esSistema      Boolean  @default(false) @map("es_sistema")
  createdAt      DateTime @default(now()) @map("created_at")

  organizacion Tenant?      @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  permisos     RolPermiso[]
  miembros     Miembro[]

  @@unique([organizacionId, codigo])
  @@map("rol")
}

model Permiso {
  clave           String  @id // "finanzas.movimientos.crear"
  modulo          String
  recurso         String
  accion          String
  grupo           String // Producción | Finanzas | Compras | Comercial | RRHH | Equipo | Configuración | Tienda
  descripcion     String // lenguaje simple, lo ve el Administrador General
  sensible        Boolean @default(false) // ve plata, datos personales o anula registros
  soloPropietario Boolean @default(false) @map("solo_propietario") // nunca se puede delegar
  orden           Int     @default(0)

  roles    RolPermiso[]
  miembros MiembroPermiso[]

  @@map("permiso")
}

model RolPermiso {
  rolId        String @map("rol_id") @db.Uuid
  permisoClave String @map("permiso_clave")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoClave], references: [clave], onDelete: Cascade)

  @@id([rolId, permisoClave])
  @@map("rol_permiso")
}

model MiembroPermiso {
  miembroId    String        @map("miembro_id") @db.Uuid
  permisoClave String        @map("permiso_clave")
  efecto       EfectoPermiso

  miembro Miembro @relation(fields: [miembroId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoClave], references: [clave], onDelete: Cascade)

  @@id([miembroId, permisoClave])
  @@map("miembro_permiso")
}

model Invitacion {
  id             String           @id @default(uuid()) @db.Uuid
  organizacionId String           @map("organizacion_id")
  email          String
  rolId          String           @map("rol_id") @db.Uuid
  cargo          String?
  ajustes        Json             @default("[]") // [{clave, efecto}]
  granjas        Json             @default("[]") // [] = TODAS
  unidades       Json             @default("[]") // [] = TODAS
  limiteCompraGs BigInt?          @map("limite_compra_gs")
  tokenHash      String           @unique @map("token_hash") // sha256; el token en claro solo viaja en el link
  expiraEn       DateTime         @map("expira_en")
  estado         EstadoInvitacion @default(PENDIENTE)
  invitadoPor    String           @map("invitado_por")
  createdAt      DateTime         @default(now()) @map("created_at")

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId, estado])
  @@map("invitacion")
}

model SolicitudUnion {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String   @map("organizacion_id")
  userId         String   @map("user_id")
  mensaje        String?
  estado         String   @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizacionId, userId])
  @@map("solicitud_union")
}

model AdminPlataforma {
  userId      String   @id @map("user_id")
  nivel       String   @default("TOTAL") // TOTAL | SOPORTE | MODERACION | LECTURA (Anexo A.10)
  otorgadoPor String?  @map("otorgado_por") // users.id del administrador TOTAL que lo autorizó
  createdAt   DateTime @default(now()) @map("created_at")

  perfil User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_plataforma")
}

model ActividadDiaria {
  userId         String   @map("user_id")
  fecha          DateTime @db.Date
  organizacionId String?  @map("organizacion_id")
  accesos        Int      @default(1)

  @@id([userId, fecha])
  @@map("actividad_diaria")
}

model Notificacion {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id")
  organizacionId String?  @map("organizacion_id")
  tipo           String
  titulo         String
  cuerpo         String?
  enlace         String?
  leida          Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, leida])
  @@map("notificacion")
}

// ================================================================
// SEGURIDAD Y AUDITORÍA (Fase 2)
// auditoria e historial_cambio son de solo agregar: un trigger rechaza
// UPDATE y DELETE (ver migración 20261107000200_fase2_seguridad).
// ================================================================

model Auditoria {
  id                String   @id @default(uuid()) @db.Uuid
  organizacionId    String?  @map("organizacion_id")
  actorId           String?  @map("actor_id") // users.id; null = sistema
  actorEsPlataforma Boolean  @default(false) @map("actor_es_plataforma")
  accion            String // LOGIN, LOGIN_FALLIDO, LOGIN_BLOQUEADO, MIEMBRO_INVITADO, PERMISOS_CAMBIADOS, EXPORTACION, ...
  entidad           String
  entidadId         String?  @map("entidad_id")
  detalle           Json     @default("{}")
  ip                String?
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([organizacionId, createdAt])
  @@index([actorId, createdAt])
  @@index([accion, createdAt])
  @@map("auditoria")
}

model HistorialCambio {
  id         BigInt   @id @default(autoincrement())
  tabla      String
  registroId String   @map("registro_id")
  operacion  String // INSERT | UPDATE | DELETE
  antes      Json?
  despues    Json?
  actorId    String?  @map("actor_id") // users.id (de la sesión o de app.actor_id)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tabla, registroId])
  @@index([createdAt])
  @@map("historial_cambio")
}

model LimiteIntento {
  clave          String    @id // "login:<correo>:<ip>", "registro:<ip>", ...
  ventanaInicio  DateTime  @default(now()) @map("ventana_inicio")
  intentos       Int       @default(0)
  nivel          Int       @default(0) // cuántas veces se bloqueó seguido: la espera se duplica
  bloqueadoHasta DateTime? @map("bloqueado_hasta")

  @@index([bloqueadoHasta])
  @@map("limite_intento")
}

model IncidenteSeguridad {
  id                    String    @id @default(uuid()) @db.Uuid
  detectadoEn           DateTime  @map("detectado_en")
  descripcion           String
  datosAfectados        String?   @map("datos_afectados")
  personasAfectadas     Int?      @map("personas_afectadas")
  notificadoAgenciaEn   DateTime? @map("notificado_agencia_en") // Ley 7593/2025: dentro de las 72 h
  notificadoTitularesEn DateTime? @map("notificado_titulares_en")
  medidas               String?
  estado                String    @default("ABIERTO") // ABIERTO | CONTENIDO | CERRADO
  registradoPor         String?   @map("registrado_por")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([estado, detectadoEn])
  @@map("incidente_seguridad")
}

// ================================================================
// CONTRATOS, ACEPTACIÓN Y PRIVACIDAD (Fase 4)
// Los textos legales viven en la base (no en componentes) para que el
// abogado los corrija sin tocar código. aceptacion_documento es de solo agregar.
// ================================================================

model DocumentoLegal {
  id                   String    @id @default(uuid()) @db.Uuid
  codigo               String // TERMINOS | PRIVACIDAD | ACUERDO_ORGANIZACION | TERMINOS_VENDEDOR | TERMINOS_MERCADO | COMUNICACIONES | BENCHMARK
  version              String // "1.0"
  titulo               String
  resumen              String // "Lo más importante", lenguaje simple
  contenidoMd          String    @map("contenido_md")
  hashSha256           String    @map("hash_sha256") // del contenido_md exacto
  resumenCambios       String?   @map("resumen_cambios")
  obligatorio          Boolean   @default(true)
  requiereReaceptacion Boolean   @default(true) @map("requiere_reaceptacion")
  aprobadoPorAsesor    Boolean   @default(false) @map("aprobado_por_asesor")
  estado               String    @default("BORRADOR") // BORRADOR | PUBLICADO | RETIRADO
  vigenteDesde         DateTime? @map("vigente_desde")
  publicadoPor         String?   @map("publicado_por")
  createdAt            DateTime  @default(now()) @map("created_at")

  aceptaciones AceptacionDocumento[]

  @@unique([codigo, version])
  @@index([codigo, estado])
  @@map("documento_legal")
}

model AceptacionDocumento {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id")
  organizacionId String?  @map("organizacion_id")
  actuaComo      String   @default("PERSONA") @map("actua_como") // PERSONA | REPRESENTANTE_ORGANIZACION
  documentoId    String   @map("documento_id") @db.Uuid
  codigo         String
  version        String
  hashSha256     String   @map("hash_sha256") // del texto exacto que se mostró (con los datos del operador)
  aceptado       Boolean // false = rechazo o revocación de un consentimiento opcional
  textoCasilla   String   @map("texto_casilla") // la frase exacta que tildó la persona
  ip             String?
  userAgent      String?  @map("user_agent")
  idioma         String   @default("es")
  metodo         String   @default("CASILLA") // CASILLA | CASILLA_INGRESO_GOOGLE
  createdAt      DateTime @default(now()) @map("created_at")

  documento DocumentoLegal @relation(fields: [documentoId], references: [id])

  @@index([userId, codigo])
  @@map("aceptacion_documento")
}

model SolicitudPrivacidad {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id")
  tipo         String // ACCESO | RECTIFICACION | SUPRESION | OPOSICION | PORTABILIDAD | REVOCAR_CONSENTIMIENTO | IMPUGNAR_DECISION_AUTOMATIZADA
  detalle      String?
  estado       String    @default("RECIBIDA") // RECIBIDA | EN_CURSO | RESPONDIDA | RECHAZADA_CON_MOTIVO | CANCELADA
  venceEn      DateTime  @map("vence_en") // created_at + 30 días corridos
  respuesta    String?
  atendidaPor  String?   @map("atendida_por")
  createdAt    DateTime  @default(now()) @map("created_at")
  respondidaEn DateTime? @map("respondida_en")

  @@index([userId])
  @@index([estado, venceEn])
  @@map("solicitud_privacidad")
}

model ConfiguracionPlataforma {
  id                 Int     @id @default(1) // una sola fila
  razonSocial        String  @map("razon_social")
  ruc                String
  domicilio          String
  correoContacto     String  @map("correo_contacto")
  correoPrivacidad   String  @map("correo_privacidad")
  whatsappSoporte    String? @map("whatsapp_soporte")
  ciudadJurisdiccion String  @default("Asunción") @map("ciudad_jurisdiccion")

  @@map("configuracion_plataforma")
}

// ================================================================
// FASE 8: FINANZAS (réplica de la planilla de Administración y Finanzas)
// Un solo lugar de carga manual: el libro de movimientos. Todo lo demás se calcula.
// Montos en BigInt (guaraníes); nunca se borra un movimiento: se anula con motivo.
// Sin fábrica de balanceado (decisión 16): el balanceado es una compra a proveedores.
// ================================================================

enum TipoMovFinanciero {
  INGRESO
  GASTO
  INVERSION
  FINANCIAMIENTO
}

enum Naturaleza {
  FIJO
  VARIABLE
  NO_APLICA
}

enum EstadoMovimiento {
  PAGADO
  PENDIENTE
  COBRADO
  POR_COBRAR
  ANULADO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  DEBITO_AUTOMATICO
  TARJETA
  CREDITO_PROVEEDOR
}

enum OrigenMovFinanciero {
  MANUAL
  VENTA
  CUOTA_PRESTAMO
  PEDIDO_MERCADO
  SUELDO
  PROVISION
  IMPORTACION
  AJUSTE
}

enum TipoCuentaFondos {
  CAJA
  CAJA_CHICA
  BANCO
  COOPERATIVA
  OTRA
}

/// CAJA / BANCO de la planilla
model CuentaFondos {
  id                String           @id @default(uuid()) @db.Uuid
  organizacionId    String           @map("organizacion_id")
  unidadId          String?          @map("unidad_id") @db.Uuid
  nombre            String
  tipo              TipoCuentaFondos
  numeroCifrado     String?          @map("numero_cifrado")
  saldoInicialGs    BigInt           @default(0) @map("saldo_inicial_gs")
  fechaSaldoInicial DateTime?        @map("fecha_saldo_inicial") @db.Date
  montoAsignadoGs   BigInt?          @map("monto_asignado_gs")
  activa            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @map("created_at")

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([organizacionId, nombre])
  @@map("cuenta_fondos")
}

/// Hoja LISTAS. organizacionId null = categoría del sistema (la ven todas las organizaciones)
model CategoriaFinanciera {
  id             String            @id @default(uuid()) @db.Uuid
  organizacionId String?           @map("organizacion_id")
  nombre         String
  tipo           TipoMovFinanciero
  area           String
  naturaleza     Naturaleza
  signo          Int
  unidadDefault  String            @map("unidad_default") // GRANJA | COMUN
  subcategorias  String[]
  grupoTablero   String?           @map("grupo_tablero") // BALANCEADO | PERSONAL | SANIDAD_VET | GENETICA | ENERGIA_AGUA | MANT_LIMPIEZA | LOGISTICA | ADMIN_OTROS
  grupoCosto     String?           @map("grupo_costo") // ALIMENTACION | OTROS_DIRECTOS | ESTRUCTURA
  dieta          String? // GESTACION | LACTACION | VILO_BABY | PRE_INICIAL_1 | PRE_INICIAL_2 | INICIAL | CRECIMIENTO | TERMINACION
  vidaUtil       String?           @map("vida_util") // OBRA | EQUIPOS | MATRIZ | null = no se amortiza
  orden          Int               @default(0)
  esSistema      Boolean           @default(false) @map("es_sistema")
  activa         Boolean           @default(true)

  organizacion Tenant?      @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  movimientos  Movimiento[]

  @@unique([organizacionId, nombre])
  @@map("categoria_financiera")
}

/// Proveedores, clientes y acreedores
model Contraparte {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String   @map("organizacion_id")
  tipo           String // PROVEEDOR | CLIENTE | AMBOS | ACREEDOR | TITULAR
  nombre         String
  ruc            String?
  telefono       String?
  email          String?
  tiendaId       String?  @map("tienda_id")
  activa         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  organizacion Tenant       @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  movimientos  Movimiento[]

  @@unique([organizacionId, nombre])
  @@map("contraparte")
}

/// Hoja MOVIMIENTOS
model Movimiento {
  id                  String              @id @default(uuid()) @db.Uuid
  organizacionId      String              @map("organizacion_id")
  unidadId            String              @map("unidad_id") @db.Uuid
  granjaId            String?             @map("granja_id")
  fecha               DateTime            @db.Date
  fechaVencimiento    DateTime?           @map("fecha_vencimiento") @db.Date
  tipo                TipoMovFinanciero
  concepto            String
  categoriaId         String              @map("categoria_id") @db.Uuid
  subcategoria        String?
  cantidad            Decimal?            @db.Decimal(14, 3)
  unidadMedida        String?             @map("unidad_medida")
  contraparteId       String?             @map("contraparte_id") @db.Uuid
  medioPago           MedioPago?          @map("medio_pago")
  cuentaFondosId      String?             @map("cuenta_fondos_id") @db.Uuid
  montoGs             BigInt              @map("monto_gs") // siempre positivo; el signo lo da la categoría
  estado              EstadoMovimiento
  observacion         String?
  // automáticos (los completa el trigger completar_movimiento)
  naturaleza          Naturaleza          @default(NO_APLICA)
  area                String              @default("")
  signo               Int                 @default(0)
  mes                 Int                 @default(0) // AAAAMM
  precioUnitarioGs    Decimal?            @map("precio_unitario_gs") @db.Decimal(16, 2)
  // sanidad
  productoSanitarioId String?             @map("producto_sanitario_id")
  mlPorUnidad         Decimal?            @map("ml_por_unidad") @db.Decimal(10, 2)
  mlComprados         Decimal?            @map("ml_comprados") @db.Decimal(14, 2)
  // trazabilidad
  origen              OrigenMovFinanciero @default(MANUAL)
  origenId            String?             @map("origen_id")
  esInterno           Boolean             @default(false) @map("es_interno")
  facturaNumero       String?             @map("factura_numero")
  comprobantePath     String?             @map("comprobante_path")
  motivoAnulacion     String?             @map("motivo_anulacion")
  anuladoPor          String?             @map("anulado_por")
  anuladoEn           DateTime?           @map("anulado_en")
  creadoPor           String              @map("creado_por")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  organizacion Tenant              @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  categoria    CategoriaFinanciera @relation(fields: [categoriaId], references: [id])
  contraparte  Contraparte?        @relation(fields: [contraparteId], references: [id])
  pagos        PagoMovimiento[]

  @@index([organizacionId, mes])
  @@index([organizacionId, categoriaId, mes])
  @@index([organizacionId, estado])
  @@map("movimiento")
}

/// Pagos y cobros (también parciales). El flujo de caja usa estas fechas.
model PagoMovimiento {
  id              String     @id @default(uuid()) @db.Uuid
  movimientoId    String     @map("movimiento_id") @db.Uuid
  fechaPago       DateTime   @map("fecha_pago") @db.Date
  montoGs         BigInt     @map("monto_gs")
  cuentaFondosId  String?    @map("cuenta_fondos_id") @db.Uuid
  medioPago       MedioPago? @map("medio_pago")
  comprobantePath String?    @map("comprobante_path")
  creadoPor       String     @map("creado_por")
  createdAt       DateTime   @default(now()) @map("created_at")

  movimiento Movimiento @relation(fields: [movimientoId], references: [id], onDelete: Cascade)

  @@index([movimientoId])
  @@index([fechaPago])
  @@map("pago_movimiento")
}

/// Hoja VENTAS
model Venta {
  id                    String    @id @default(uuid()) @db.Uuid
  organizacionId        String    @map("organizacion_id")
  unidadId              String    @map("unidad_id") @db.Uuid
  granjaId              String?   @map("granja_id")
  fechaSalida           DateTime  @map("fecha_salida") @db.Date
  tipoVenta             String    @map("tipo_venta") // LECHONES | MATRIZ_DESCARTE | REPRODUCTOR | DOSIS_SEMINALES | CERDO_TERMINADO | OTRO
  loteDesteteId         String?   @map("lote_destete_id")
  loteEngordeId         String?   @map("lote_engorde_id")
  edadPromDias          Int?      @map("edad_prom_dias")
  cantidad              Int
  kgTotales             Decimal   @map("kg_totales") @db.Decimal(12, 2)
  modoPrecio            String    @default("POR_KG") @map("modo_precio") // POR_KG | POR_CABEZA
  precioGsKg            BigInt?   @map("precio_gs_kg")
  precioGsCabeza        BigInt?   @map("precio_gs_cabeza")
  importeGs             BigInt    @map("importe_gs")
  destino               String // ENGORDE | CONSUMO | CARNEADO | REPRODUCCION | FRIGORIFICO
  clienteId             String    @map("cliente_id") @db.Uuid
  recibePor             String?   @map("recibe_por")
  remitoFactura         String?   @map("remito_factura")
  guiaTraslado          String?   @map("guia_traslado")
  fechaVencimientoCobro DateTime? @map("fecha_vencimiento_cobro") @db.Date
  movimientoId          String    @map("movimiento_id") @db.Uuid
  rendimientoPct        Decimal?  @map("rendimiento_pct") @db.Decimal(5, 2) // venta por kg de canal
  kgCanal               Decimal?  @map("kg_canal") @db.Decimal(12, 2)
  descuentosGs          BigInt    @default(0) @map("descuentos_gs") // tipificación
  fleteGs               BigInt    @default(0) @map("flete_gs")
  estado                String    @default("CONFIRMADA") // CONFIRMADA | ANULADA
  creadoPor             String    @map("creado_por")
  createdAt             DateTime  @default(now()) @map("created_at")

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId, fechaSalida])
  @@map("venta")
}

/// Hoja DEUDAS Y FINANCIAMIENTO
model Prestamo {
  id                String   @id @default(uuid()) @db.Uuid
  organizacionId    String   @map("organizacion_id")
  unidadId          String   @map("unidad_id") @db.Uuid
  acreedorId        String   @map("acreedor_id") @db.Uuid
  concepto          String
  montoRecibidoGs   BigInt   @map("monto_recibido_gs")
  cuotaMensualGs    BigInt   @map("cuota_mensual_gs")
  numeroCuotas      Int      @map("numero_cuotas")
  primerVencimiento DateTime @map("primer_vencimiento") @db.Date
  debitoAutomatico  Boolean  @default(false) @map("debito_automatico")
  cuentaDebitoId    String?  @map("cuenta_debito_id") @db.Uuid
  observacion       String?
  estado            String   @default("VIGENTE") // VIGENTE | CANCELADO | REFINANCIADO
  creadoPor         String   @map("creado_por")
  createdAt         DateTime @default(now()) @map("created_at")

  organizacion Tenant          @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  cuotas       CuotaPrestamo[]

  @@map("prestamo")
}

model CuotaPrestamo {
  id           String   @id @default(uuid()) @db.Uuid
  prestamoId   String   @map("prestamo_id") @db.Uuid
  numero       Int
  vencimiento  DateTime @db.Date
  montoGs      BigInt   @map("monto_gs")
  movimientoId String?  @map("movimiento_id") @db.Uuid

  prestamo Prestamo @relation(fields: [prestamoId], references: [id], onDelete: Cascade)

  @@unique([prestamoId, numero])
  @@map("cuota_prestamo")
}

/// Hoja PRESUPUESTO
model Presupuesto {
  id             String @id @default(uuid()) @db.Uuid
  organizacionId String @map("organizacion_id")
  unidadId       String @map("unidad_id") @db.Uuid
  categoriaId    String @map("categoria_id") @db.Uuid
  mes            Int
  montoGs        BigInt @map("monto_gs")

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([organizacionId, unidadId, categoriaId, mes])
  @@map("presupuesto")
}

/// PARÁMETROS, sección 6
model AporteCapitalPrevisto {
  id             String  @id @default(uuid()) @db.Uuid
  organizacionId String  @map("organizacion_id")
  mes            Int
  montoGs        BigInt  @map("monto_gs")
  descripcion    String?

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@map("aporte_capital_previsto")
}

/// Hoja NUEVA INVERSIÓN
model EvaluacionInversion {
  id               String   @id @default(uuid()) @db.Uuid
  organizacionId   String   @map("organizacion_id")
  fechaPrevista    DateTime @map("fecha_prevista") @db.Date
  concepto         String
  categoriaId      String   @map("categoria_id") @db.Uuid
  cantidad         Decimal  @db.Decimal(12, 2)
  montoTotalGs     BigInt   @map("monto_total_gs")
  formaPago        String   @map("forma_pago") // CONTADO | FINANCIADO | MIXTO
  financiamientoGs BigInt   @default(0) @map("financiamiento_gs")
  plazoMeses       Int      @default(0) @map("plazo_meses")
  tasaAnual        Decimal? @map("tasa_anual") @db.Decimal(7, 4)
  estado           String   @default("EN_EVALUACION") // EN_EVALUACION | APROBADA | DESCARTADA | EJECUTADA
  createdAt        DateTime @default(now()) @map("created_at")

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@map("evaluacion_inversion")
}

/// Hoja PARÁMETROS (una fila por organización)
model ParametrosFinancieros {
  organizacionId              String  @id @map("organizacion_id")
  precioReferenciaLechonGs    BigInt  @default(435000) @map("precio_referencia_lechon_gs")
  precioKgVivoGs              BigInt  @default(18500) @map("precio_kg_vivo_gs")
  pesoVentaKg                 Decimal @default(25) @map("peso_venta_kg") @db.Decimal(6, 2)
  modoProyeccionVentas        String  @default("PARAMETRO") @map("modo_proyeccion_ventas") // PARAMETRO | CALENDARIO_BANDAS
  lechonesAVenderMes          Int     @default(80) @map("lechones_a_vender_mes")
  precioEsperadoLechonGs      BigInt  @default(435000) @map("precio_esperado_lechon_gs")
  otrosIngresosMesGs          BigInt  @default(0) @map("otros_ingresos_mes_gs")
  colchonMesesEgreso          Decimal @default(1) @map("colchon_meses_egreso") @db.Decimal(4, 2)
  consumoGestacionKgDia       Decimal @default(2.5) @map("consumo_gestacion_kg_dia") @db.Decimal(5, 2)
  consumoLactacionKgDia       Decimal @default(8) @map("consumo_lactacion_kg_dia") @db.Decimal(5, 2)
  preInicial1KgLechon         Decimal @default(2) @map("pre_inicial1_kg_lechon") @db.Decimal(5, 2)
  preInicial2KgLechon         Decimal @default(4) @map("pre_inicial2_kg_lechon") @db.Decimal(5, 2)
  inicialKgLechon             Decimal @default(35) @map("inicial_kg_lechon") @db.Decimal(5, 2)
  tasaDescuentoVan            Decimal @default(0.12) @map("tasa_descuento_van") @db.Decimal(5, 4)
  crecimientoFlujoAnual       Decimal @default(0.10) @map("crecimiento_flujo_anual") @db.Decimal(5, 4)
  metaCoberturaDias           Int     @default(30) @map("meta_cobertura_dias")
  alertaCoberturaDias         Int     @default(20) @map("alerta_cobertura_dias")
  metaDesvio                  Decimal @default(0.05) @map("meta_desvio") @db.Decimal(5, 4)
  alertaDesvio                Decimal @default(0.10) @map("alerta_desvio") @db.Decimal(5, 4)
  vidaObraAnios               Int     @default(20) @map("vida_obra_anios")
  vidaEquiposAnios            Int     @default(10) @map("vida_equipos_anios")
  modoAmortizacion            String  @default("POR_ACTIVO") @map("modo_amortizacion") // PLANILLA | POR_ACTIVO
  amortizarMatrices           Boolean @default(false) @map("amortizar_matrices")
  vidaMatrizMeses             Int     @default(36) @map("vida_matriz_meses")
  valorDescarteMatrizGs       BigInt  @default(2000000) @map("valor_descarte_matriz_gs")
  imputacionSanidad           String  @default("USO") @map("imputacion_sanidad") // COMPRA | USO
  tasaIpsPatronal             Decimal @default(0.165) @map("tasa_ips_patronal") @db.Decimal(5, 4)
  provisionarAguinaldo        Boolean @default(true) @map("provisionar_aguinaldo")
  limiteAprobacionPagoGs      BigInt? @map("limite_aprobacion_pago_gs") // pagos mayores requieren finanzas.pagar.aprobar
  matricesActivasManual       Int?    @map("matrices_activas_manual") // si se carga, reemplaza al promedio de Plantel
  precioTransferenciaLechon   String  @default("MERCADO") @map("precio_transferencia_lechon") // MERCADO | COSTO (Fase 9)
  porcentajeEstructuraEngorde Decimal @default(0) @map("porcentaje_estructura_engorde") @db.Decimal(5, 4) // parte de los gastos fijos que va al engorde

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@map("parametros_financieros")
}

model CierreMes {
  id               String    @id @default(uuid()) @db.Uuid
  organizacionId   String    @map("organizacion_id")
  unidadId         String?   @map("unidad_id") @db.Uuid // null = toda la organización
  mes              Int
  estado           String    @default("ABIERTO") // ABIERTO | EN_REVISION | CERRADO
  checklist        Json      @default("{}")
  saldosDeclarados Json      @default("[]") @map("saldos_declarados") // [{cuentaFondosId, saldoGs, fecha}]
  snapshot         Json?
  cerradoPor       String?   @map("cerrado_por")
  cerradoEn        DateTime? @map("cerrado_en")
  motivoReapertura String?   @map("motivo_reapertura")

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([organizacionId, unidadId, mes])
  @@map("cierre_mes")
}

/// Saldo contado (caja) o de extracto (banco) a una fecha
model SaldoDeclarado {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String   @map("organizacion_id")
  cuentaFondosId String   @map("cuenta_fondos_id") @db.Uuid
  fecha          DateTime @db.Date
  saldoGs        BigInt   @map("saldo_gs")
  observacion    String?
  declaradoPor   String   @map("declarado_por")
  createdAt      DateTime @default(now()) @map("created_at")

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId, cuentaFondosId, fecha])
  @@map("saldo_declarado")
}

/// La causa escrita al lado del número
model CausaDesvio {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String   @map("organizacion_id")
  categoriaId    String   @map("categoria_id") @db.Uuid
  mes            Int
  causa          String
  autorId        String   @map("autor_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([organizacionId, categoriaId, mes])
  @@map("causa_desvio")
}

/// Hoja MEJORAS, generada por reglas
model Recomendacion {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String   @map("organizacion_id")
  codigo         String
  mes            Int
  problema       String
  situacion      String
  mejora         String
  impacto        String
  prioridad      String // ALTA | MEDIA | BAJA
  accion         String
  estado         String   @default("ABIERTA") // ABIERTA | EN_CURSO | RESUELTA | DESCARTADA
  generadaEn     DateTime @default(now()) @map("generada_en")

  organizacion Tenant @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([organizacionId, codigo, mes])
  @@map("recomendacion")
}

/// Hoja DATOS ORIGINALES: copia fiel de lo importado, no se usa en cálculos
model ImportacionFilaOriginal {
  id             BigInt   @id @default(autoincrement())
  organizacionId String   @map("organizacion_id")
  importacionId  String   @map("importacion_id") @db.Uuid
  archivo        String
  hoja           String
  fila           Int
  datos          Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizacionId, importacionId])
  @@map("importacion_fila_original")
}

// ================================================================
// FASE 11: PANEL DEL SUPER ADMINISTRADOR
// ================================================================

/// Cada lectura de datos de una organización desde el panel de plataforma (inmutable)
model AccesoPlataforma {
  id             String   @id @default(uuid()) @db.Uuid
  adminId        String   @map("admin_id")
  organizacionId String?  @map("organizacion_id")
  seccion        String
  motivo         String // SOPORTE | SEGURIDAD | CUMPLIMIENTO_LEGAL | ESTADISTICA | MEJORA_DEL_PRODUCTO | OTRO
  detalleMotivo  String?  @map("detalle_motivo")
  exportacion    Boolean  @default(false)
  filas          Int?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizacionId, createdAt])
  @@index([adminId, createdAt])
  @@map("acceso_plataforma")
}

/// Padrón de contribuyentes ACTIVOS de la DNIT (datos públicos), para validar el RUC y completar la razón social.
/// Se recarga con `npm run db:padron-ruc`. Solo lo lee el servidor. Un RUC que no está acá no figura como activo.
model RucDnit {
  ruc         Int    @id // sin dígito verificador
  dv          Int    @db.SmallInt
  razonSocial String @map("razon_social")

  @@map("ruc_dnit")
}

/// Producción mensual traída de la planilla (hoja PRODUCCIÓN). Solo se usa en los meses en que los
/// módulos productivos todavía no tienen registros (8.29): la historia previa al ERP.
model ProduccionMensualImportada {
  organizacionId   String @map("organizacion_id")
  mes              Int
  servicios        Int    @default(0)
  partos           Int    @default(0)
  nacidosTotales   Int    @default(0) @map("nacidos_totales")
  nacidosVivos     Int    @default(0) @map("nacidos_vivos")
  muertosAlNacer   Int    @default(0) @map("muertos_al_nacer")
  destetados       Int    @default(0)
  muertosLactancia Int    @default(0) @map("muertos_lactancia")

  @@id([organizacionId, mes])
  @@map("produccion_mensual_importada")
}

/// Curva de crecimiento esperada para engorde (la carga la Jefatura de Producción)
model CurvaEngorde {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String   @map("organizacion_id")
  nombre         String
  puntos         Json // [{ dia: 0, pesoKg: 25, consumoKgDia: 1.1 }, ...]
  predeterminada Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizacionId])
  @@map("curva_engorde")
}
