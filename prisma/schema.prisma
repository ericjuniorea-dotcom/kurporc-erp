// KurPorc ERP — Schema PostgreSQL completo
// Multi-tenancy: tenant_id en todas las tablas + Row-Level Security en PostgreSQL
// Migración a schema-por-tenant documentada en docs/multi-tenancy.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================================================================
// ENUMS
// ================================================================

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Language {
  ES
  GN
  PT
}

enum ServiceType {
  AI // Inseminación artificial
  NATURAL_MOUNT // Monta natural
}

enum PregnancyCheckMethod {
  ULTRASOUND
  BLOOD_TEST
  VISUAL
}

enum PregnancyCheckResult {
  PREGNANT
  NOT_PREGNANT
  RECHECK
}

enum FarrowingType {
  NORMAL
  ASSISTED
  CESAREAN
  DYSTOCIA
}

enum PigletSex {
  MALE
  FEMALE
}

enum PigletIdentType {
  TATTOO
  EAR_TAG
}

enum PigletStatus {
  VIABLE
  LOW_VIABILITY
}

enum PigletDeathCause {
  WEAKNESS
  CRUSHING
  DIARRHEA
  DEFICIENT
  DISEASE
  SHELTER
  HYPOTHERMIA
  ACCIDENT
  CONGENITAL
  ELIMINATED
  OTHER
}

enum SowDisposalDestination {
  GESTATION
  CULL
  OTHER
}

enum BodyConditionScore {
  SCORE_1
  SCORE_2
  SCORE_3
  SCORE_4
  SCORE_5
}

enum StockAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NurseryPhase {
  PHASE_1
  PHASE_2
}

enum PhaseChangeReason {
  WEIGHT
  SPACE
}

enum RawMaterialType {
  PROTEIN
  ENERGY
  NUCLEUS
  ADDITIVE
  MINERAL
}

enum FormulaStatus {
  ACTIVE
  INACTIVE
  SUPERSEDED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  COMPLETE
  PARTIAL
}

enum HealthTaskType {
  TAIL_DOCKING
  TOOTH_CLIPPING
  CASTRATION
  IRON_INJECTION
  VACCINATION
  CLEANING
  OTHER_PROCEDURE
}

enum VaccinationRoute {
  IM
  SC
  ORAL
}

enum DiagnosisType {
  DIARRHEA
  ARTHRITIS
  PNEUMONIA
  OTHER
}

enum EstadoTratamiento {
  ACTIVO
  EN_SEGUIMIENTO
  FINALIZADO
  ABANDONADO
}

enum ProcedimientoMaternidadTipo {
  DESCOLMILLADO
  CORTE_COLA
  CORTE_OMBLIGO
  HIERRO
  CASTRACION
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertType {
  // Maternidad
  PIGLETS_OVERDUE_WEANING
  SOW_STOCK_NEGATIVE
  SOW_ZERO_PIGLETS_NO_WEANING
  FARROWING_LONG_DURATION
  LOW_BIRTH_WEIGHT
  GESTATION_DAYS_OUT_OF_RANGE
  SOW_OVERDUE_FARROWING
  WITHDRAWAL_PERIOD_NEAR_WEANING
  // Gestación
  PEAK_FARROWINGS_PROJECTED
  SEMEN_DOSE_EXPIRED
  HEAT_REPEAT_DISCARD
  LOW_CONCEPTION_RATE
  // Recría / Engorde
  BATCH_REACHED_TRANSFER_WEIGHT
  PEN_OVER_CAPACITY
  NO_PENS_AVAILABLE
  // BAL / Alimentación
  FINISHED_STOCK_BELOW_MIN
  RAW_MATERIAL_BELOW_MIN
  MYCOTOXIN_LIMIT_EXCEEDED
  PROJECTED_SHORTAGE_60_DAYS
  BATCH_NOT_FED
