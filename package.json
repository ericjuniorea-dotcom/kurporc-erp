{
  "name": "kurporc-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrar-orgs": "ts-node --transpile-only -P scripts/tsconfig.json scripts/migrar_a_organizaciones.ts",
    "db:migrar-auth": "ts-node --transpile-only -P scripts/tsconfig.json scripts/migrar_usuarios_a_supabase_auth.ts",
    "db:superadmin": "ts-node --transpile-only -P scripts/tsconfig.json scripts/asignar_superadmin.ts",
    "db:padron-ruc": "ts-node --transpile-only -P scripts/tsconfig.json scripts/cargar_padron_ruc.ts",
    "db:importar-planilla": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/importar_planilla.ts",
    "db:importar-produccion": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/importar_produccion.ts",
    "db:legales": "ts-node --transpile-only -P scripts/tsconfig.json scripts/cargar_documentos_legales.ts",
    "prueba:alta": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/pruebas/alta_organizacion.ts",
    "prueba:permisos": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/pruebas/permisos.ts",
    "prueba:dborg": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/pruebas/aislamiento_dborg.ts",
    "prueba:finanzas": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/pruebas/finanzas_calculos.ts",
    "prueba:ventas": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/pruebas/ventas.ts",
    "prueba:cerdas-paradas": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/pruebas/cerdas_paradas.ts",
    "prueba:engorde": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/pruebas/engorde.ts",
    "prueba:mercado": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/pruebas/mercado.ts",
    "prueba:pedidos": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/pruebas/pedidos.ts",
    "prueba:necesidades": "ts-node --transpile-only -r tsconfig-paths/register -P scripts/tsconfig.json scripts/pruebas/necesidades.ts",
    "db:seed": "ts-node --transpile-only -P scripts/tsconfig.json prisma/seed.ts",
    "db:setup": "prisma migrate deploy && ts-node --transpile-only -P scripts/tsconfig.json prisma/seed.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "setup": "npm install && docker compose up -d && npx prisma migrate deploy && ts-node --transpile-only -P scripts/tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.18.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tabler/icons-react": "^3.44.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.426.0",
    "next": "15.5.29",
    "openai": "^7.53.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.52.2",
    "recharts": "^2.12.7",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^20.14.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.2",
    "bcryptjs": "2.4.3",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.5.4"
  }
}
