# ================================================================
# KurPorc ERP — Variables de entorno
# Copiá este archivo a .env.local y completá los valores reales
# ================================================================

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/kurporc_db"

# NextAuth — generá una clave aleatoria: openssl rand -base64 32
NEXTAUTH_SECRET="tu_clave_secreta_aqui"
NEXTAUTH_URL="http://localhost:3000"

# Redis (para sesiones WhatsApp y colas Bull)
REDIS_URL="redis://localhost:6379"

# IA — Anthropic (análisis de PDFs de materias primas)
ANTHROPIC_API_KEY="sk-ant-..."

# IA — OpenAI (transcripción Whisper para audios de WhatsApp)
OPENAI_API_KEY="sk-..."

# WhatsApp Business API (Meta)
WHATSAPP_TOKEN="EAAxxxxx..."        # Token de acceso permanente de la app Meta
WHATSAPP_PHONE_ID="10000000000000" # Phone Number ID de tu número de WhatsApp Business
WHATSAPP_VERIFY_TOKEN="kurporc_verify"  # Token de verificación del webhook (elegís vos)

# Firebase (notificaciones push — opcional en fase inicial)
FIREBASE_PROJECT_ID="kurporc-erp"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@kurporc-erp.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Almacenamiento S3 (fotos de evidencia — opcional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="kurporc-evidencias"
