# ================================================================
# KurPorc ERP — Variables de entorno
# Copiar a .env.local para desarrollo
# ================================================================

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kurporc_erp?schema=public"

# Redis (para Bull queues y sesiones WhatsApp)
REDIS_URL="redis://localhost:6379"

# AWS S3 (o compatible: MinIO, Cloudflare R2)
AWS_REGION="sa-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="kurporc-files"
S3_ENDPOINT=""  # Dejar vacío para AWS nativo, o URL para S3-compatible

# Claude API (Anthropic) — lectura de PDFs, análisis nutricional, bot WhatsApp
ANTHROPIC_API_KEY=""

# OpenAI (Whisper) — transcripción de audio del bot
OPENAI_API_KEY=""

# Meta WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""  # Token secreto para verificar el webhook

# Firebase Cloud Messaging (push notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="KurPorc ERP"

# ── Seguridad (Fase 2) ─────────────────────────────────────────────
# Cifrado de campos sensibles (cédula, cuentas bancarias…). 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde CAMPOS_CIFRADOS_KEY, los datos cifrados NO se pueden recuperar: guardala fuera de Vercel también.
CAMPOS_CIFRADOS_KEY=""
CAMPOS_HMAC_KEY=""
# Content-Security-Policy: vacío = solo informa (Report-Only); "enforce" = bloquea.
CSP_MODO=""
# Super Administrador de la plataforma (correos separados por coma; usado por db:migrar-orgs)
SUPERADMIN_EMAIL=""

# ── Supabase Auth (Fase 3) ──────────────────────────────────────────
# Supabase → Project Settings → API. La anon/publishable es pública; la service_role es SECRETA (solo servidor).
NEXT_PUBLIC_SUPABASE_URL="https://<proyecto>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SITE_URL="https://www.kurporc.com"
